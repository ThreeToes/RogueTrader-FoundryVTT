<section class="tab {{tabs.data.cssClass}}" data-group="primary" data-tab="data">
    <div class="stats border">
        <h1>{{localize "TITLE.STATS"}}</h1>
        {{#if battlesuitSystem}}
        {{!-- Tau battlesuit system (bead i0dc): the category Table 1-5 names and
             the Hard Point cost the suit's budget is spent on. --}}
        <div class="stats-row">
            <div class="stat battlesuit-category">
                <label>{{localize "BATTLESUIT_SYSTEM.CATEGORY"}}</label>
                {{#if editable}}
                <select name="system.category">
                    {{selectOptions (config "battlesuitSystemCategories") selected=source.system.category localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "battlesuitSystemCategories") source.system.category)}}</p>
                {{/if}}
            </div>
            <div class="stat battlesuit-hard-points">
                <label>{{localize "BATTLESUIT_SYSTEM.HARD_POINT_COST"}}</label>
                {{#if editable}}
                <input name="system.hardPointCost" type="number" min="0" value="{{source.system.hardPointCost}}"
                    data-tooltip="{{localize "BATTLESUIT_SYSTEM.HARD_POINT_COST_HINT"}}" />
                {{else}}
                <p class="static-value">{{source.system.hardPointCost}}</p>
                {{/if}}
            </div>
        </div>
        {{/if}}
        <div class="stats-row">
            <div class="stat craftsmanship">
                <label>{{localize "GEAR.CRAFTSMANSHIP"}}</label>
                {{#if editable}}
                <select name="system.craftsmanship">
                    {{selectOptions (config "craftsmanship") selected=source.system.craftsmanship localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "craftsmanship") source.system.craftsmanship)}}</p>
                {{/if}}
            </div>
            <div class="stat availability">
                <label>{{localize "GEAR.AVAILABILITY"}}</label>
                {{#if editable}}
                <select name="system.availability">
                    {{selectOptions (config "availability") selected=source.system.availability localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "availability") source.system.availability)}}</p>
                {{/if}}
            </div>
            <div class="stat equip-state">
                <label>{{localize "GEAR.EQUIP_STATE"}}</label>
                {{#if editable}}
                <select name="system.equipState">
                    {{selectOptions (config "equipStates") selected=source.system.equipState localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "equipStates") source.system.equipState)}}</p>
                {{/if}}
            </div>
            <div class="stat weight">
                <label>{{localize "GEAR.WEIGHT"}}</label>
                {{#if editable}}
                <input name="system.weight" type="number" value="{{source.system.weight}}" />
                {{else}}
                <p class="static-value">{{source.system.weight}}</p>
                {{/if}}
            </div>
        </div>
        {{#if editable}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                {{> rt/effect-editor labelKey="EFFECTS.LIST" hintKey="EFFECTS.HINT" kindTipKey="EFFECTS.KIND_HINT" testTipKey="EFFECTS.TEST_KEY_HINT" valueTipKey="EFFECTS.VALUE_HINT" noneKey="EFFECTS.NONE"}}
            </div>
        </div>
        {{else}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                {{> rt/effect-editor labelKey="EFFECTS.LIST" hintKey="EFFECTS.HINT" kindTipKey="EFFECTS.KIND_HINT" testTipKey="EFFECTS.TEST_KEY_HINT" valueTipKey="EFFECTS.VALUE_HINT" noneKey="EFFECTS.NONE"}}
            </div>
        </div>
        {{/if}}
    </div>
</section>