#!/bin/sh
# Pre-commit hook mirroring the FULL verification sequence of
# .forgejo/workflows/ci.yaml (bead qdmc; full-parity extension 2026-10-20
# after packless-CI failures leaked through the pre-build hook gap).
# Install once per clone with: bun run hooks:install
#
# Checks: typecheck (pure + scoped), lint, bun test, verify:templates, build.
#
# The hook runs the same steps and order as ci.yaml, PLUS a packless parity
# pass (bead 0qyi, option a): the hook sees src/packs, CI does not, and the
# 2026-10-22 CI red was a test that failed only then (afflictions pack
# guard). Two closures: (1) utils/pack-read-guard.test.ts fails `bun test`
# when a src/ or utils/ suite reads a src/packs path at runtime with no
# skipIf/existsSync guard (static, fast — catches the direct-read class);
# (2) the packless pass below runs `bun test` in a throwaway worktree with
# NO src/packs, which is the CI condition exactly — it closes the class at
# any layer, including helper-indirection reads the static guard cannot see
# (the 2026-10-25 CI red was emit-careers-yaml's keyAdvance reading the
# packs from inside a helper). The packless suite is small (pack-dependent
# tests skip) and runs in ~1-2s. New pack-driven tests must use the skipIf
# guard shape of rules/origins.test.ts. Bypass with: git commit --no-verify.
set -eu

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "==> bun run typecheck (pure + scoped)"
if bun run typecheck; then echo "    typecheck OK"; else echo "    typecheck FAILED"; fail=1; fi

echo "==> bun run lint"
if bun run lint; then echo "    lint OK"; else echo "    lint FAILED"; fail=1; fi

echo "==> bun test"
if bun test; then echo "    bun test OK"; else echo "    bun test FAILED"; fail=1; fi

echo "==> bun run verify:templates"
if bun run verify:templates; then echo "    verify:templates OK"; else echo "    verify:templates FAILED"; fail=1; fi

echo "==> bun run build"
if bun run build; then echo "    build OK"; else echo "    build FAILED"; fail=1; fi

echo "==> packless parity pass (CI condition: no src/packs)"
# git exports GIT_DIR / GIT_INDEX_FILE etc. into the hook's environment; the
# child git must not inherit them (worktree add resolves the relative
# GIT_INDEX_FILE against the NEW worktree and dies with "index file open
# failed: Not a directory"), so strip the inherited git vars for the whole
# parity section.
CLEAN_GIT="env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
	-u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES git"

# Cleanup is a trap on EXIT, not inline: the hook runs under set -eu, so any
# mid-setup failure (mktemp, ln -s, worktree add) or a signal during the test
# run aborts before inline cleanup lines are reached, leaking BOTH a
# registered worktree entry (.git/worktrees — prunable but present) and its
# directory. The trap covers success, failure, and kill alike.
parity_cleanup() {
	if [ -n "${PARITY_WORKTREE:-}" ] && [ -d "$PARITY_WORKTREE" ]; then
		$CLEAN_GIT worktree remove --force "$PARITY_WORKTREE" >/dev/null 2>&1 ||
			{ rm -rf "$PARITY_WORKTREE"; $CLEAN_GIT worktree prune >/dev/null 2>&1; }
	fi
	$CLEAN_GIT worktree prune >/dev/null 2>&1
	rm -rf "$PARITY_BASE"
}
trap parity_cleanup EXIT

PARITY_BASE="$(mktemp -d)"
PACKLESS_WORKTREE="$PARITY_BASE/packless"
PARITY_FAIL=0

if $CLEAN_GIT worktree add --detach "$PACKLESS_WORKTREE" HEAD >/dev/null 2>&1; then
    # node_modules does not exist in a fresh worktree; symlink this
    # checkout's — same bun/binary, same packages.
    ln -s "$(pwd)/node_modules" "$PACKLESS_WORKTREE/node_modules"
    # The worktree checks out HEAD — but the commit being made does not
    # exist yet, and the hook's job is to gate THAT tree. write-tree reads
    # the commit's index (the hook inherits GIT_INDEX_FILE); a two-way
    # read-tree -m -u HEAD <tree> then materialises the staged delta in the
    # worktree (adds, edits AND deletions). reset --hard cannot be used:
    # it rejects a bare tree ("a tree, not a commit").
    if ! COMMIT_TREE=$($CLEAN_GIT write-tree); then
        echo "    setup FAILED: write-tree could not read the index — refusing;"
        echo "    CI parity cannot be verified for this commit."
        PARITY_FAIL=1
    fi
    if [ "$PARITY_FAIL" -eq 0 ]; then
        $CLEAN_GIT -C "$PACKLESS_WORKTREE" read-tree -m -u HEAD "$COMMIT_TREE" \
            >/dev/null 2>&1 || PARITY_FAIL=1
        [ "$PARITY_FAIL" -eq 0 ] || echo "    setup FAILED: could not materialise the"
        [ "$PARITY_FAIL" -eq 0 ] || echo "    staged tree in the parity worktree."
    fi
    if (cd "$PACKLESS_WORKTREE" && bun test); then
        echo "    packless bun test OK"
    else
        echo "    packless bun test FAILED (CI would fail: this run had no src/packs)"
        PARITY_FAIL=1
    fi
else
    echo "    setup FAILED: could not create the packless worktree — refusing this"
    echo "    commit because CI parity cannot be verified. If it persists, try"
    echo "    'git worktree prune'; the escape hatch is --no-verify."
    PARITY_FAIL=1
fi
[ "$PARITY_FAIL" -eq 0 ] || fail=1

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "pre-commit checks FAILED — commit refused."
    echo "To bypass (discouraged): git commit --no-verify"
    exit 1
fi

echo ""
echo "All pre-commit checks passed."