<section class="talent-content">
    <div class="stats border">
        <h1>{{localize "TALENT.HEADER"}}</h1>
        <div class="stats-row">
            <div class="stat">
                <label>{{localize "TALENT.CATEGORY"}}</label>
                {{#if editable}}
                <select name="system.category">
                    {{selectOptions categoryChoices selected=source.system.category localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{categoryLabel}}</p>
                {{/if}}
            </div>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat full-width">
                <label>{{localize "TITLE.DESCRIPTION"}}</label>
                {{#if editable}}
                <prose-mirror
                    name="system.description"
                    value="{{source.system.description}}"
                    button="true"
                    editable="{{editable}}"
                    toggled="false"
                >
                    {{{descriptionHTML}}}
                </prose-mirror>
                {{else}}
                <div class="description-readonly">{{{descriptionHTML}}}</div>
                {{/if}}
            </div>
        </div>
        <div class="stats-row">
            <div class="stat talents-effects">
                {{> rt/effect-editor labelKey="TALENT.EFFECTS" hintKey="TALENT.EFFECTS_HINT" kindTipKey="TALENT.KIND_HINT" testTipKey="TALENT.TEST_KEY_HINT" valueTipKey="TALENT.VALUE_HINT" noneKey="TALENT.NO_EFFECTS"}}
            </div>
        </div>
    </div>
</section>