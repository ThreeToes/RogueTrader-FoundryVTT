<div class="header border flex row">
    <div class="avatar">
        <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-field="img"
            alt="{{actor.name}}" title="{{actor.name}}" />
    </div>
    <div class="flex column grow justify-center">
        <div class="name header-row">
            <label>{{localize "ITEM.NAME"}}</label>
            <input name="name" type="text" value="{{actor.name}}" />
        </div>
    </div>
</div>