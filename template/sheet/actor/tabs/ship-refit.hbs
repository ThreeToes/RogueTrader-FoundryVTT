<section class="tab {{tabs.refit.cssClass}}" data-group="primary" data-tab="refit">
    <div class="starship border">
        {{!-- Budget strip FIRST (bead 7dt0): power/space/SP meters recompute
             on every render, so installing a component shows its cost here
             immediately. Alarm colour when over capacity. --}}
        <div class="refit-budget">
            <h2 class="inv-group-label">{{localize "STARSHIP.REFIT_BUDGET"}}</h2>
            {{> "rt/capacity-bar" label=(localize "STARSHIP.POWER") used=derived.powerUsed total=derived.powerGenerated pct=meters.power.pct over=meters.power.over}}
            {{> "rt/capacity-bar" label=(localize "STARSHIP.SPACE") used=derived.spaceUsed total=system.space.total pct=meters.space.pct over=meters.space.over}}
            {{> "rt/capacity-bar" label=(localize "DYNASTY.SHIP_POINTS") used=derived.spSpent total=system.sp.total pct=meters.sp.pct over=meters.sp.over}}
        </div>

        {{!-- Drag-and-drop install (bead pyi3): drag ship-component /
             ship-weapon-component items here from the ships compendium.
             Non-component items are refused with a loud warning. --}}
        <p class="method-hint">{{localize "STARSHIP.DROP_HINT"}}</p>

        {{#each weaponIssues as |issue|}}
        <p class="method-hint warn">⚠ {{localize "STARSHIP.WEAPON_ISSUE"}}: {{issue.name}} —
            {{issue.message}}{{#if issue.slot}} ({{issue.slot}}){{/if}}</p>
        {{/each}}

        {{!-- Installed components: inventory-style, grouped by category --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "STARSHIP.COMPONENTS"}}</h2>
            <span class="acq-group-count">{{components.length}}</span>
        </div>
        {{#if components.length}}
        <div class="starship-components">
            {{#each installedGroups as |group|}}
            <div class="inv-group-header">
                <h3 class="inv-group-label">{{localize group.labelKey}}</h3>
                <span class="acq-group-count">{{group.items.length}}</span>
            </div>
            {{#each group.items as |c|}}
            {{#> "rt/ship-component-row" id=c.id name=c.name state=c.state stateLabel=c.stateLabel cost=c.cost}}
            <a class="inv-delete" data-action="removeComponent" data-item-id="{{c.id}}"
                data-tooltip="{{localize "STARSHIP.COMPONENT_REMOVE"}}"><i class="fa-solid fa-xmark"></i></a>
            {{#if (eq c.type "ship-weapon-component")}}
            {{!-- Second child row (owner round 5): weapon slot as BUTTON
                 CHIPS, centred UNDER the row — no dropdown. The leading "—"
                 chip unassigns the slot. @root across the partial-block
                 boundary is the only working parent lookup (see
                 utils/template-partial-scope.test.ts). --}}
            <span class="sc-slot-chips" role="group"
                data-tooltip="{{localize "STARSHIP.SLOT_HINT"}}">
                <button type="button" class="slot-chip{{#if (eq c.slot "")}} checked{{/if}}"
                    data-action="setWeaponSlot" data-item-id="{{c.id}}" data-slot=""
                    aria-pressed="{{#if (eq c.slot "")}}true{{else}}false{{/if}}">—</button>
                {{!-- Per-weapon chips (owner round 7): slots the hull has no
                     capacity for, broadside-illegal slots, and full slots are
                     DISABLED with the reason as their tooltip. --}}
                {{#each c.slotChips as |chip|}}
                <button type="button" class="slot-chip {{chip.key}}{{#if (eq c.slot chip.key)}} checked{{/if}}"
                    data-action="setWeaponSlot" data-item-id="{{c.id}}" data-slot="{{chip.key}}"
                    {{#if chip.disabled}}disabled data-tooltip="{{chip.reason}}"{{else}}aria-pressed="{{#if (eq c.slot chip.key)}}true{{else}}false{{/if}}"{{/if}}
                >{{chip.label}}</button>
                {{/each}}
            </span>
            {{/if}}
            {{/"rt/ship-component-row"}}
            {{/each}}
            {{/each}}
        </div>
        {{else}}
        <p class="method-hint">{{localize "STARSHIP.COMPONENTS_EMPTY"}}</p>
        {{/if}}

        {{!-- Browse pickers + hull picker REMOVED (owner round 5): drag
             and drop from the ships compendium is the install path, and
             choosing a different hull is effectively a different ship. --}}
    </div>
</section>