<section class="trait-content">
    <div class="stats border">
        <h1>{{localize "TRAIT.HEADER"}}</h1>
        <div class="stats-row">
            <div class="stat full-width">
                <label>{{localize "TRAIT.BENEFIT"}}</label>
                {{#if editable}}
                <input name="system.benefit" type="text" value="{{source.system.benefit}}"
                    data-tooltip="{{localize "TRAIT.BENEFIT_HINT"}}" />
                {{else}}
                <p class="static-value">{{source.system.benefit}}</p>
                {{/if}}
            </div>
        </div>
        <div class="stats-row">
            <div class="stat full-width">
                <label>{{localize "TITLE.DESCRIPTION"}}</label>
                {{#if editable}}
                <prose-mirror
                    name="system.description"
                    value="{{source.system.description}}"
                    button="true"
                    editable="{{editable}}"
                    toggled="false"
                >
                    {{{descriptionHTML}}}
                </prose-mirror>
                {{else}}
                <div class="description-readonly">{{{descriptionHTML}}}</div>
                {{/if}}
            </div>
        </div>
        <div class="stats-row">
            <div class="stat talents-effects">
                {{> rt/effect-editor labelKey="TALENT.EFFECTS" hintKey="TALENT.EFFECTS_HINT" kindTipKey="TALENT.KIND_HINT" testTipKey="TALENT.TEST_KEY_HINT" valueTipKey="TALENT.VALUE_HINT" noneKey="TALENT.NO_EFFECTS"}}
            </div>
        </div>
    </div>
</section>