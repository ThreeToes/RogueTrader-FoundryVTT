<section class="tab {{tabs.data.cssClass}}" data-group="primary" data-tab="data">
    <div class="stats border">
        <h1>{{localize "TITLE.STATS"}}</h1>
        <div class="stats-row">
            <div class="stat class">
                <label>{{localize "WEAPON.CLASS"}}</label>
                {{#if editable}}
                <select name="system.class">
                    {{selectOptions classChoices selected=source.system.class localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup classChoices source.system.class)}}</p>
                {{/if}}
            </div>
            <div class="stat family">
                <label>{{localize "WEAPON.FAMILY"}}</label>
                {{#if editable}}
                <select name="system.weaponFamily">
                    {{selectOptions familyChoices selected=source.system.weaponFamily localize=true blank="—"}}
                </select>
                {{else}}
                <p class="static-value">{{#if source.system.weaponFamily}}{{localize (lookup familyChoices source.system.weaponFamily)}}{{else}}—{{/if}}</p>
                {{/if}}
            </div>
            <div class="stat range">
                <label>{{localize "WEAPON.RANGE"}}</label>
                {{#if editable}}
                <input name="system.range" type="number" value="{{source.system.range}}" />
                {{else}}
                <p class="static-value">{{source.system.range}}</p>
                {{/if}}
            </div>
            <div class="stat weight">
                <label>{{localize "GEAR.WEIGHT"}}</label>
                {{#if editable}}
                <input name="system.weight" type="number" value="{{source.system.weight}}" />
                {{else}}
                <p class="static-value">{{source.system.weight}}</p>
                {{/if}}
            </div>
        </div>
        <div class="stats-row">
            <div class="stat damage grow-2">
                <label>{{localize "WEAPON.DAMAGE_FULL"}}</label>
                {{#if editable}}
                <input name="system.damage" type="text" value="{{source.system.damage}}" />
                {{else}}
                <p class="static-value">{{source.system.damage}}</p>
                {{/if}}
            </div>
            <div class="stat damage-type">
                <label>{{localize "WEAPON.DAMAGE_TYPE"}}</label>
                {{#if editable}}
                <select name="system.damageType">
                    {{selectOptions damageTypeChoices selected=source.system.damageType localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup damageTypeChoices source.system.damageType)}}</p>
                {{/if}}
            </div>
            <div class="stat penetration">
                <label>{{localize "WEAPON.PENETRATION_FULL"}}</label>
                {{#if editable}}
                <input name="system.penetration" type="number" value="{{source.system.penetration}}" />
                {{else}}
                <p class="static-value">{{source.system.penetration}}</p>
                {{/if}}
            </div>
            <div class="stat availability">
                <label>{{localize "GEAR.AVAILABILITY"}}</label>
                {{#if editable}}
                <select name="system.availability">
                    {{selectOptions (config "availability") selected=source.system.availability localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "availability") source.system.availability)}}</p>
                {{/if}}
            </div>
            <div class="stat equip-state">
                <label>{{localize "GEAR.EQUIP_STATE"}}</label>
                {{#if editable}}
                <select name="system.equipState">
                    {{selectOptions (config "equipStates") selected=source.system.equipState localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "equipStates") source.system.equipState)}}</p>
                {{/if}}
            </div>
        </div>

        {{#if isRanged}}
        <div class="stats-row">
            <div class="stat rate-of-fire grow-2">
                <label>{{localize "RANGED_WEAPON.RATE_OF_FIRE"}}</label>
                {{#if editable}}
                <div class="rof-composite"
                    data-tooltip="{{localize "RANGED_WEAPON.SINGLE_SHOT"}} / {{localize "RANGED_WEAPON.BURST"}} / {{localize "RANGED_WEAPON.FULL_AUTO"}}">
                    <label class="rof-single">
                        <input type="checkbox" name="system.rateOfFire.singleShot"
                            {{checked source.system.rateOfFire.singleShot}} />
                        <span class="rof-s {{#unless source.system.rateOfFire.singleShot}}off{{/unless}}">S</span>
                    </label>
                    <span class="rof-sep">/</span>
                    <span class="rof-num {{#unless source.system.rateOfFire.burst}}has-zero{{/unless}}">
                        <input name="system.rateOfFire.burst" type="number" min="0"
                            value="{{source.system.rateOfFire.burst}}" />
                        {{#unless source.system.rateOfFire.burst}}<span class="rof-zero">&ndash;</span>{{/unless}}
                    </span>
                    <span class="rof-sep">/</span>
                    <span class="rof-num {{#unless source.system.rateOfFire.fullAuto}}has-zero{{/unless}}">
                        <input name="system.rateOfFire.fullAuto" type="number" min="0"
                            value="{{source.system.rateOfFire.fullAuto}}" />
                        {{#unless source.system.rateOfFire.fullAuto}}<span class="rof-zero">&ndash;</span>{{/unless}}
                    </span>
                </div>
                {{else}}
                <p class="static-value">
                    {{#if source.system.rateOfFire.singleShot}}S{{else}}&ndash;{{/if}} /
                    {{#if source.system.rateOfFire.burst}}{{source.system.rateOfFire.burst}}{{else}}&ndash;{{/if}} /
                    {{#if source.system.rateOfFire.fullAuto}}{{source.system.rateOfFire.fullAuto}}{{else}}&ndash;{{/if}}
                </p>
                {{/if}}
            </div>
            <div class="stat clip">
                <label>{{localize "RANGED_WEAPON.CLIP"}}</label>
                {{#if editable}}
                <input name="system.clip" type="number" min="0" value="{{source.system.clip}}" />
                {{else}}
                <p class="static-value">{{source.system.clip}}</p>
                {{/if}}
            </div>
            <div class="stat reload">
                <label>{{localize "RANGED_WEAPON.RELOAD"}}</label>
                {{#if editable}}
                <input name="system.reload" type="number" min="0" value="{{source.system.reload}}" />
                {{else}}
                <p class="static-value">{{source.system.reload}}</p>
                {{/if}}
            </div>
        </div>
        {{#if launcher}}
        {{!-- Launcher load model (bead 4obp): loaded item name + remaining
             quantity display, Load/Unload affordances, and the accepted
             ordnance kind the homebrewer can author. --}}
        <div class="stats-row">
            <div class="stat loaded-ordnance grow-2">
                <label>{{localize "RANGED_WEAPON.LOADED_ORDNANCE"}}</label>
                {{#if launcher.loaded}}
                <p class="static-value"><span class="loaded-name">{{launcher.loaded.name}}</span>
                    <span class="loaded-quantity">&times;{{launcher.loaded.quantity}}</span></p>
                {{else}}
                <p class="static-value">{{localize "RANGED_WEAPON.LOADED_NONE"}}</p>
                {{/if}}
            </div>
            {{#if editable}}
            <div class="stat ordnance-actions">
                <label>{{localize "RANGED_WEAPON.ORDNANCE_ACTIONS"}}</label>
                {{#if launcher.loaded}}
                <button type="button" data-action="unloadOrdnance">{{localize "RANGED_WEAPON.UNLOAD"}}</button>
                {{else}}
                <button type="button" data-action="loadOrdnance">{{localize "RANGED_WEAPON.LOAD"}}</button>
                {{/if}}
            </div>
            <div class="stat accepts-ammo">
                <label>{{localize "RANGED_WEAPON.ACCEPTS_AMMO"}}</label>
                <input name="system.acceptsAmmo" type="text" value="{{launcher.acceptsAmmo}}"
                    data-tooltip="{{localize "RANGED_WEAPON.ACCEPTS_AMMO_HINT"}}" />
            </div>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}

        <div class="stats-row">
            <div class="stat craftsmanship">
                <label>{{localize "GEAR.CRAFTSMANSHIP"}}</label>
                {{#if editable}}
                <select name="system.craftsmanship">
                    {{selectOptions (config "craftsmanship") selected=source.system.craftsmanship localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "craftsmanship") source.system.craftsmanship)}}</p>
                {{/if}}
            </div>
        </div>

        <div class="stats-row">
            <div class="stat">
                <label>{{localize "WEAPON.PRIMITIVE"}}</label>
                {{#if editable}}
                <input type="checkbox" name="system.primitive" {{checked source.system.primitive}}
                    data-tooltip="{{localize "WEAPON.PRIMITIVE_HINT"}}" />
                {{else}}
                <p class="static-value">{{#if source.system.primitive}}{{localize "WEAPON.PRIMITIVE"}}{{else}}—{{/if}}</p>
                {{/if}}
            </div>
            <div class="stat special">
                <label>{{localize "WEAPON.SPECIAL"}}</label>
                {{#if editable}}
                <div class="chip-select">
                    {{#each (config "qualities") as |label key|}}
                    <label class="chip-option" data-tooltip="{{localize label}}">
                        <input type="checkbox" name="system.special" value="{{key}}"
                            {{checked (lookup ../specialFlags key)}} />
                        <span class="chip">{{localize label}}</span>
                    </label>
                    {{/each}}
                </div>
                {{else}}
                <p class="static-value">{{#each specialFlags as |on key|}}{{#if on}}{{localize (lookup (config "qualities") key)}} {{/if}}{{/each}}</p>
                {{/if}}
            </div>
        </div>
        {{#if editable}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                {{> rt/effect-editor labelKey="EFFECTS.LIST" hintKey="EFFECTS.HINT" kindTipKey="EFFECTS.KIND_HINT" testTipKey="EFFECTS.TEST_KEY_HINT" valueTipKey="EFFECTS.VALUE_HINT" noneKey="EFFECTS.NONE"}}
            </div>
        </div>
        {{else}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                {{> rt/effect-editor labelKey="EFFECTS.LIST" hintKey="EFFECTS.HINT" kindTipKey="EFFECTS.KIND_HINT" testTipKey="EFFECTS.TEST_KEY_HINT" valueTipKey="EFFECTS.VALUE_HINT" noneKey="EFFECTS.NONE"}}
            </div>
        </div>
        {{/if}}

    </div>
</section>