<div class="ship-creator">
    <div class="creator-header">
        <input type="text" name="ship-name" value="{{name}}" placeholder="{{localize "SHIP_CREATOR.NAME_PLACEHOLDER"}}" />
    </div>

    {{!-- Step 0: hull (ships pack) + SP budget (Table 1-5, owner redesign note) --}}
    {{#if (eq step 0)}}
    <h2>{{localize "SHIP_CREATOR.STEP_HULL"}}</h2>
    <div class="form-group">
        <label>{{localize "SHIP_CREATOR.SP_BUDGET"}}</label>
        <input type="number" name="sp-budget" value="{{spBudget}}" min="0"
            data-tooltip="{{localize "SHIP_CREATOR.SP_BUDGET_HINT"}}" />
    </div>
    <p class="method-hint">{{localize "SHIP_CREATOR.SP_BUDGET_HINT"}}</p>
    <div class="form-group">
        <label>{{localize "SHIP_CREATOR.HULLS"}}</label>
        <select class="ship-hull-select">
            <option value="">{{localize "SHIP_CREATOR.NOT_INSTALLED"}}</option>
            {{#each hullOptions as |h|}}
            <option value="{{h.uuid}}" {{#if (eq h.uuid ../hullUuid)}}selected{{/if}}>{{h.name}} ({{h.sp}} SP)</option>
            {{/each}}
        </select>
    </div>
    {{#if hullDetail}}
    <div class="comp-details border">
        <div class="starship-status">
            <span class="chip origin-mod">SP {{hullDetail.sp}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.HULL_INTEGRITY"}} {{hullDetail.hullIntegrity}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.ARMOUR"}} {{hullDetail.armour}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.SPEED"}} {{hullDetail.speed}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.MANOEUVRAABILITY"}} {{hullDetail.manoeuvrability}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.DETECTION"}} {{hullDetail.detection}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.TURRET_RATING"}} {{hullDetail.turretRating}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.SPACE"}} {{hullDetail.space}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.WEAPON_CAPACITY"}}: {{hullDetail.weaponCapacity}}</span>
        </div>
        {{{hullDetail.description}}}
        {{#if hullDetail.specialRules}}
        <div class="comp-special">{{{hullDetail.specialRules}}}</div>
        {{/if}}
    </div>
    {{/if}}
    {{/if}}

    {{!-- Step 1-2: components with running validation --}}
    {{#if (gt step 0)}}
    <div class="starship-status">
        <span class="chip origin-mod">{{localize "STARSHIP.HULL"}}: {{hullName}}</span>
        <span class="chip origin-mod">{{localize "WEAPON.POWER"}} {{derived.powerUsed}}/{{derived.powerGenerated}} {{#if derived.powerDeficit}}<span class="warn">⚠ {{derived.powerDeficit}}</span>{{/if}}</span>
        <span class="chip origin-mod">{{localize "STARSHIP.SPACE"}} {{derived.spaceUsed}}/{{derived.hullSpace}}</span>
        <span class="chip origin-mod">SP {{derived.spSpent}}/{{derived.spBudget}} {{#if derived.overBudget}}<span class="warn">⚠ {{derived.spLeft}}</span>{{/if}}</span>
        <span class="chip origin-mod">{{localize "SHIP_CREATOR.CREW_SKILL"}} {{derived.crewSkill}} ({{localize "SHIP_CREATOR.SP_DELTA"}} {{derived.crewSpDelta}})</span>
    </div>

    <h2>{{#if (eq step 1)}}{{localize "SHIP_CREATOR.STEP_ESSENTIAL"}}{{else}}{{localize "SHIP_CREATOR.STEP_SUPPLEMENTAL"}}{{/if}}</h2>

    {{!-- Picked components (inventory rows, removable) --}}
    {{#if picks.length}}
    <div class="starship-components">
        {{#each picks as |p|}}
        {{#> "rt/inv-row" id=p.id name=p.name deleteAction="unpickComponent" deleteTooltip=(localize "SHIP_CREATOR.UNPICK")}}
        <span class="chip origin-mod">{{localize "WEAPON.POWER"}} {{p.power}}</span>
        <span class="chip origin-mod">{{localize "STARSHIP.SPACE"}} {{p.space}}</span>
        <span class="chip origin-mod">SP {{p.sp}}</span>
        {{/"rt/inv-row"}}
        {{/each}}
    </div>
    {{else}}
    <p class="method-hint">{{localize "SHIP_CREATOR.NO_PICKS"}}</p>
    {{/if}}

    {{#if (eq step 1)}}
    {{!-- Essential components (Core Rulebook p200): ONE dropdown per
         category — "A ship must have one (no more) Component from each of
         the following categories". Options filtered to the hull class,
         alphabetical. Selecting replaces the previous pick of that type. --}}
    {{#each essentialTypes as |slot|}}
    <div class="form-group">
        <label>{{localize slot.labelKey}}</label>
        <select class="ship-essential-select" data-component-type="{{slot.type}}"
            data-tooltip="{{localize "SHIP_CREATOR.SLOT_HINT"}}">
            <option value="">{{localize "SHIP_CREATOR.NOT_INSTALLED"}}</option>
            {{#each slot.options as |o|}}
            <option value="{{o.uuid}}" {{#if (eq o.uuid ../slot.selected)}}selected{{/if}}>{{o.name}}</option>
            {{/each}}
        </select>
        {{#if slot.detail}}
        <div class="comp-details">
            <div class="starship-status">
                <span class="chip origin-mod">{{localize "WEAPON.POWER"}} {{slot.detail.power}}</span>
                <span class="chip origin-mod">{{localize "STARSHIP.SPACE"}} {{slot.detail.space}}</span>
                <span class="chip origin-mod">SP {{slot.detail.sp}}</span>
            </div>
            {{#if slot.detail.special}}<div class="comp-special">{{slot.detail.special}}</div>{{/if}}
            {{{slot.detail.description}}}
        </div>
        {{/if}}
        {{#unless slot.options.length}}
        <span class="method-hint warn">{{localize "SHIP_CREATOR.NO_OPTIONS_FOR_HULL"}}</span>
        {{/unless}}
    </div>
    {{/each}}
    {{/if}}

    {{#if (eq step 2)}}
    {{!-- Details panel (owner ask): the last-clicked component's flavour
         + stats, from the pack. --}}
    {{#if inspected}}
    <div class="comp-details border">
        <h3 class="inv-group-label">{{inspected.name}}</h3>
        <div class="starship-status">
            <span class="chip origin-mod">{{localize "WEAPON.POWER"}} {{inspected.power}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.SPACE"}} {{inspected.space}}</span>
            <span class="chip origin-mod">SP {{inspected.sp}}</span>
        </div>
        {{#if inspected.special}}<div class="comp-special">{{inspected.special}}</div>{{/if}}
        {{{inspected.description}}}
    </div>
    {{/if}}
    {{!-- Supplemental components (Core Rulebook p203): multiples and
         duplicates allowed; grouped by component type (Table 8-4 headings
         first), alphabetical within each group. --}}
    {{#each supplementalGroups as |group|}}
    <div class="acq-group">
        <button type="button" class="acq-group-header" data-action="toggleGroup" data-group="{{group.type}}">
            <i class="fa-solid {{#if (lookup ../collapse group.type)}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
            {{localize group.labelKey}}
            <span class="acq-group-count">({{group.options.length}})</span>
        </button>
        {{#if (lookup ../collapse group.type)}}
        {{else}}
        <div class="pick-chips">
            {{#each group.options as |o|}}
            <a class="pick-chip {{#if o.picked}}selected{{/if}}" data-action="pickComponent" data-uuid="{{o.uuid}}"
                data-tooltip="{{localize "WEAPON.POWER"}} {{o.power}} · {{localize "STARSHIP.SPACE"}} {{o.space}} · SP {{o.sp}}">{{o.name}}</a>
            {{/each}}
        </div>
        {{/if}}
    </div>
    {{/each}}
    {{/if}}

    <div class="form-group">
        <label>{{localize "STARSHIP.CREW_QUALITY"}}</label>
        <select data-action="setCrewQuality" data-tooltip="{{localize "SHIP_CREATOR.CREW_HINT"}}">
            {{selectOptions crewQualities selected=crewQuality}}
        </select>
    </div>
    {{/if}}

    <div class="creator-actions">
        {{#if (gt step 0)}}
        <button type="button" class="rt-button" data-action="prev">{{localize "SHIP_CREATOR.PREV"}}</button>
        {{/if}}
        {{#if (lt step 2)}}
        <button type="button" class="rt-button" data-action="next">{{localize "SHIP_CREATOR.NEXT"}}</button>
        {{else}}
        <button type="button" class="rt-button" data-action="finish">{{localize "SHIP_CREATOR.FINISH"}}</button>
        {{/if}}
    </div>
</div>