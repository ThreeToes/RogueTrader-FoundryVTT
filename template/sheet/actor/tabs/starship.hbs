<section class="tab {{tabs.hull.cssClass}}" data-group="primary" data-tab="hull">
    <div class="starship border">
        <h1>{{localize "STARSHIP.TAB_HULL"}}</h1>

        {{!-- Hull snapshot (copied from the ships pack when the hull is chosen) --}}
        <div class="traits-row">
            <span class="origin-label">{{localize "STARSHIP.HULL_CLASS"}}:</span>
            <span class="origin-name">{{system.hullName}}</span>
            <span class="chip origin-mod">{{system.hullClass}}</span>
        </div>
        <div class="traits-row">
            <span class="origin-label">{{localize "STARSHIP.DIMENSIONS"}}:</span>
            <span class="origin-name">{{system.dimensions}}</span>
            <span class="origin-label">{{localize "STARSHIP.MASS"}}:</span>
            <span class="origin-name">{{system.mass}}</span>
        </div>
        <div class="traits-row">
            <span class="origin-label">{{localize "STARSHIP.CREW_DETAIL"}}:</span>
            <span class="origin-name">{{system.crew}}</span>
            <span class="origin-label">{{localize "STARSHIP.ACCEL"}}:</span>
            <span class="origin-name">{{system.accel}}</span>
        </div>

        {{!-- Statline: compact 3-column grid (design-language stats-row pattern) --}}
        <div class="stat-grid">
            <div class="stat">
                <label>{{localize "STARSHIP.SPEED"}}</label>
                <input name="system.speed" type="number" min="0" value="{{system.speed}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.MANOEUVRAABILITY"}}</label>
                <input name="system.manoeuvrability" type="number" value="{{system.manoeuvrability}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.DETECTION"}}</label>
                <input name="system.detection" type="number" value="{{system.detection}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.HULL_INTEGRITY"}}</label>
                <div class="composite">
                    <input name="system.hullIntegrity.value" type="number" min="0" value="{{system.hullIntegrity.value}}" />
                    <span class="sep">/</span>
                    <span class="chip origin-mod">{{system.hullIntegrity.max}}</span>
                </div>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.ARMOUR"}}</label>
                <input name="system.armour" type="number" min="0" value="{{system.armour}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.TURRET_RATING"}}</label>
                <input name="system.turretRating" type="number" min="0" value="{{system.turretRating}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.SPACE"}}</label>
                <div class="composite">
                    <span class="chip origin-mod" data-tooltip="{{localize "STARSHIP.DERIVED_HINT"}}">{{derived.spaceUsed}}</span>
                    <span class="sep">/</span>
                    <input name="system.space.total" type="number" min="0" value="{{system.space.total}}" />
                </div>
            </div>
            <div class="stat">
                <label>{{localize "DYNASTY.SHIP_POINTS"}}</label>
                <div class="composite">
                    <span class="chip origin-mod" data-tooltip="{{localize "STARSHIP.DERIVED_HINT"}}">{{derived.spSpent}}</span>
                    <span class="sep">/</span>
                    <input name="system.sp.total" type="number" min="0" value="{{system.sp.total}}" />
                </div>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.POWER"}}</label>
                <div class="composite">
                    <span class="chip origin-mod {{#if derived.powerDeficit}}claimed{{/if}}">{{derived.powerUsed}}</span>
                    <span class="sep">/</span>
                    <span class="chip origin-mod">{{derived.powerGenerated}}</span>
                </div>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.VOID_SHIELDS"}}</label>
                <div class="composite">
                    <input name="system.voidShields" type="number" min="0" value="{{system.voidShields}}" />
                    <span class="sep">/</span>
                    <span class="chip origin-mod">{{derived.voidShieldsMax}}</span>
                </div>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_POPULATION"}}</label>
                <input name="system.crewPopulation" type="number" min="0" max="100" value="{{system.crewPopulation}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_MORALE"}}</label>
                <input name="system.crewMorale" type="number" min="0" max="100" value="{{system.crewMorale}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.WEAPON_CAPACITY"}}</label>
                <input name="system.weaponCapacity" type="text" value="{{system.weaponCapacity}}" />
            </div>
        </div>

        {{!-- Crew quality (Core Rulebook p193) --}}
        <div class="traits-row">
            <span class="origin-label">{{localize "STARSHIP.CREW_QUALITY"}}:</span>
            <select name="system.crewQuality">
                {{selectOptions crewQualities selected=system.crewQuality localize=true}}
            </select>
            <span class="chip origin-mod">{{localize "STARSHIP.CREW_SKILL"}} {{crewSkill}}</span>
            <span class="chip origin-mod">{{#if (gt crewSpDelta 0)}}+{{/if}}{{crewSpDelta}} SP</span>
        </div>

        {{!-- Complications (Tables 8-1 / 8-2) --}}
        <div class="traits-row">
            <span class="origin-label">{{localize "STARSHIP.ODDITY"}}:</span>
            <span class="origin-name">{{system.machineSpiritOddity}}</span>
            <button type="button" class="ladder-option" data-action="rollOddity"
                data-tooltip="{{localize "STARSHIP.ROLL_HINT"}}">{{localize "STARSHIP.ROLL"}}</button>
        </div>
        <div class="traits-row">
            <span class="origin-label">{{localize "STARSHIP.HISTORY"}}:</span>
            <span class="origin-name">{{system.pastHistory}}</span>
            <button type="button" class="ladder-option" data-action="rollHistory"
                data-tooltip="{{localize "STARSHIP.ROLL_HISTORY"}}">{{localize "STARSHIP.ROLL_HISTORY"}}</button>
        </div>

        <div class="traits-row">
            <label class="origin-label">{{localize "DYNASTY.NOTES"}}</label>
        </div>
        {{editor source.system.notes target="system.notes" button=true editable=editable engine="prosemirror"}}
    </div>
</section>