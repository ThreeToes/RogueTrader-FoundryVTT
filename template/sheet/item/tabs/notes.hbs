<section class="tab {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes">
    <div class="notes-editor border">
        <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
        {{#if editable}}
        <prose-mirror name="system.description" value="{{source.system.description}}" button="true"
            editable="{{editable}}" toggled="false">
            {{{descriptionHTML}}}
        </prose-mirror>
        {{else}}
        {{{descriptionHTML}}}
        {{/if}}
    </div>
</section>