{{!-- Spend-XP dialog (epic lzeb child 2). Header: pool/spent/rank
     stats-row + the xp-to-next-rank meter. Rank chips select the shown
     rank's table; the search/filter toolbar filters its rows (dialog-held
     state, wired in AdvancementDialog). Sections: shown rank table, the
     Characteristic Advance Scheme (p38), a locked next-rank preview. Data
     actions buy/buyCharacteristic/refund/selectRank/toggleFilter. --}}
<div class="advancement">
    {{#if rankUp}}
    <p class="rank-up-note">{{localize "ADVANCE.RANK_UP_NOTE"}}</p>
    {{/if}}
    {{#unless hasCareer}}
    <p class="untrained-hint">{{localize "ADVANCE.NO_CAREER"}}</p>
    {{/unless}}

    {{#if alternateOffers.length}}
    <h2>{{localize "ADVANCE.ALTERNATE_RANKS"}}</h2>
    <p class="method-hint">{{localize "ADVANCE.ALTERNATE_HINT"}}</p>
    <ul class="alternate-offers">
        {{#each alternateOffers as |offer|}}
        <li><strong>{{offer.name}}</strong>{{#if offer.notesText}} <em>({{offer.notesText}})</em>{{/if}}</li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if hasCareer}}
    <div class="advancement-header stats-row">
        <div class="stat">
            <label>{{localize "ADVANCE.POOL"}}</label>
            <span class="stat-value">{{pool}} {{localize "ADVANCE.XP"}}</span>
        </div>
        <div class="stat">
            <label>{{localize "ADVANCE.SPENT"}}</label>
            <span class="stat-value">{{spent}} {{localize "ADVANCE.XP"}}</span>
        </div>
        <div class="stat">
            <label>{{localize "CAREER.RANK"}}</label>
            <span class="stat-value">{{rank}}</span>
        </div>
    </div>
    <div class="advancement-meter">
        {{#if progress.nextRank}}
        <span class="cb-label">{{localize "ADVANCE.NEXT_RANK"}} {{progress.nextRank}}</span>
        <span class="cb-track"><span class="cb-fill" style="width: {{progressPct}}%"></span></span>
        <span class="cb-value">{{progress.remaining}} {{localize "ADVANCE.XP_REMAINING"}}</span>
        {{else}}
        <span class="cb-label">{{localize "ADVANCE.MAX_RANK"}}</span>
        {{/if}}
    </div>

    {{#if rankGroups.length}}
    <div class="rank-chips">
        {{#each rankGroups as |group|}}
        <button type="button" class="pick-chip{{#if (eq group.rank ../selectedRank)}} selected{{/if}}"
            data-action="selectRank" data-rank="{{group.rank}}">{{localize "CAREER.RANK"}} {{group.rank}}</button>
        {{/each}}
    </div>

    <div class="advancement-toolbar">
        <input type="search" name="advancement-search" value="{{search}}"
            placeholder="{{localize "ADVANCE.SEARCH_PLACEHOLDER"}}" />
        <button type="button" class="pick-chip filter-chip{{#if onlyAffordable}} selected{{/if}}"
            data-action="toggleFilter" data-filter="affordable">{{localize "ADVANCE.FILTER_AFFORDABLE"}}</button>
        <button type="button" class="pick-chip filter-chip{{#if onlyUnowned}} selected{{/if}}"
            data-action="toggleFilter" data-filter="unowned">{{localize "ADVANCE.FILTER_UNOWNED"}}</button>
    </div>

    {{#if shownGroup}}
    <div class="rank-group shown">
        <h3>{{localize "CAREER.RANK"}} {{shownGroup.rank}} <em>({{localize "ADVANCE.XP_LEVEL"}} {{shownGroup.xpLevel}}, {{localize "ADVANCE.SPENT"}} {{shownGroup.spentOnRank}})</em></h3>
        <ol class="advancement-rows">
            {{#each shownGroup.rows as |row|}}
            <li class="advancement-row{{#unless row.affordable}} unaffordable{{/unless}}"
                {{#if row.benefitTooltip}}data-tooltip="{{row.benefitTooltip}}"{{/if}}>
                <span class="adv-name">
                    {{!-- Bead ha1y: resolved rows link to their pack doc's
                    sheet; unresolvable/parameterised rows stay plain text. --}}
                    {{#if row.uuid}}<a class="adv-doc-link" data-action="openPackDoc" data-uuid="{{row.uuid}}"
                        data-tooltip="{{localize "ADVANCE.OPEN_DOC"}}">{{row.name}}</a>{{else}}{{row.name}}{{/if}}
                    {{#if row.sourceName}}<em class="adv-source">{{row.sourceName}}</em>{{/if}}
                    {{#if (gt row.multiplier 1)}}<span class="adv-multiplier{{#if row.purchased}} owned{{/if}}" data-tooltip="{{localize "ADVANCE.PURCHASED"}}">{{row.purchased}}/{{row.multiplier}}</span>{{else}}{{#if row.purchased}}<span class="adv-multiplier owned">{{localize "ADVANCE.OWNED"}}</span>{{/if}}{{/if}}
                    {{#each row.unmetPrereqs as |req|}}<span class="adv-prereq unmet">[{{req}}]</span>{{/each}}
                    {{#if (and row.prereqText (not row.unmetPrereqs.length))}}<span class="adv-prereq">[{{row.prereqText}}]</span>{{/if}}
                </span>
                {{#if row.skill}}
                <span class="adv-ladder">
                    {{#if row.skill.newSkill}}<em>{{localize "ADVANCE.NEW_SKILL"}}</em>{{else if row.skill.maxed}}<em>{{localize "ADVANCE.LADDER_MAXED"}}</em>{{else}}
                    <span class="ladder-current">{{row.skill.currentLadder}}</span>
                    <i class="fa-solid fa-angle-right"></i>
                    <span class="ladder-next">{{row.skill.nextLadder}}</span>
                    {{/if}}
                </span>
                {{/if}}
                <span class="adv-detail">{{row.cost}} {{localize "ADVANCE.XP"}}</span>
                <button type="button" class="adv-buy" data-action="buy" data-key="{{row.key}}" data-name="{{row.name}}"
                    data-type="{{row.type}}" data-cost="{{row.cost}}" data-multiplier="{{row.multiplier}}"
                    data-rank="{{row.rank}}" data-prerequisites="{{row.prereqList}}" data-source="{{row.source}}"
                    {{#unless (and ../canBuy row.remaining row.affordable)}}disabled{{/unless}}>
                    {{#if row.purchased}}{{localize "ADVANCE.BUY_AGAIN"}}{{else}}{{localize "ADVANCE.BUY"}}{{/if}}
                </button>
                {{#if ../isGM}}
                {{#if row.purchased}}
                <button type="button" class="adv-refund" data-action="refund" data-index="{{row.ledgerIndex}}"
                    data-tooltip="{{localize "ADVANCE.REFUND"}}"><i class="fa-solid fa-rotate-left"></i></button>
                {{/if}}
                {{/if}}
            </li>
            {{/each}}
        </ol>
        {{#if shownEmpty}}
        <p class="method-hint">{{localize "ADVANCE.NO_MATCHES"}}</p>
        {{/if}}
    </div>
    {{/if}}
    {{/if}}
    {{/if}}

    <h2>{{localize "ADVANCE.CHARACTERISTIC_SCHEME"}}</h2>
    <ol class="advancement-rows">
        {{#each characteristics as |c|}}
        <li class="advancement-row{{#unless c.affordable}} unaffordable{{/unless}}">
            <span class="adv-name">{{localize c.labelKey}}</span>
            {{#if c.next}}
            <span class="adv-detail">
                +5 {{#if c.tierLabelKey}}<span class="adv-tier">{{localize c.tierLabelKey}}</span> — {{/if}}{{c.next.cost}} {{localize "ADVANCE.XP"}}
                <em>({{c.purchased}} {{localize "ADVANCE.PURCHASED"}})</em>
            </span>
            <button type="button" class="adv-buy" data-action="buyCharacteristic" data-key="{{c.key}}"
                {{#unless (and ../canBuy c.affordable)}}disabled{{/unless}}>{{localize "ADVANCE.BUY"}}</button>
            {{else}}
            <span class="adv-detail"><em>{{localize "ADVANCE.EXHAUSTED"}}</em></span>
            {{/if}}
        </li>
        {{/each}}
    </ol>

    {{#if nextRankPreview}}
    <div class="next-rank-preview locked">
        <h2>{{localize "ADVANCE.NEXT_RANK_PREVIEW"}} — {{localize "CAREER.RANK"}} {{nextRankPreview.rank}}
            ({{localize "ADVANCE.XP_LEVEL"}} {{nextRankPreview.xpLevel}})</h2>
        <ol class="advancement-rows">
            {{#each nextRankPreview.rows as |row|}}
            <li class="advancement-row locked">
                <span class="adv-name">
                    {{!-- Bead ha1y: the locked next-rank preview links too —
                    the same enrichment path, informational only (no buy
                    button lives here), so planning ahead can open sheets. --}}
                    {{#if row.uuid}}<a class="adv-doc-link" data-action="openPackDoc" data-uuid="{{row.uuid}}"
                        data-tooltip="{{localize "ADVANCE.OPEN_DOC"}}">{{row.name}}</a>{{else}}{{row.name}}{{/if}}
                    {{#if (gt row.multiplier 1)}}<span class="adv-multiplier">{{row.purchased}}/{{row.multiplier}}</span>{{/if}}
                    {{#each row.unmetPrereqs as |req|}}<span class="adv-prereq unmet">[{{req}}]</span>{{/each}}
                    {{#if (and row.prereqText (not row.unmetPrereqs.length))}}<span class="adv-prereq">[{{row.prereqText}}]</span>{{/if}}
                </span>
                <span class="adv-detail">{{row.cost}} {{localize "ADVANCE.XP"}}</span>
            </li>
            {{/each}}
        </ol>
    </div>
    {{/if}}
</div>