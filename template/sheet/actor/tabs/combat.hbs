<section class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
    <div class="combat border">
        <h1>{{localize "TAB.ARMOUR"}}</h1>
        {{#if armourLocations}}
        <div class="armour-body" data-tooltip="{{localize "ARMOUR.TOTAL_TOOLTIP"}}">
            <div class="body-row head-row">
                {{#with armourLocations.head}}
                <div class="body-part head" data-location="head">
                    <span class="part-label">{{localize "BODY_LOCATION.HEAD"}}</span>
                    <span class="part-ap">{{ap}}</span>
                </div>
                {{/with}}
            </div>
            <div class="body-row">
                {{#with (lookup armourLocations "left-arm")}}
                <div class="body-part" data-location="left-arm">
                    <span class="part-label">{{localize "BODY_LOCATION.LEFT_ARM"}}</span>
                    <span class="part-ap">{{ap}}</span>
                </div>
                {{/with}}
                {{#with armourLocations.body}}
                <div class="body-part body-torso" data-location="body">
                    <span class="part-label">{{localize "BODY_LOCATION.BODY"}}</span>
                    <span class="part-ap">{{ap}}</span>
                </div>
                {{/with}}
                {{#with (lookup armourLocations "right-arm")}}
                <div class="body-part" data-location="right-arm">
                    <span class="part-label">{{localize "BODY_LOCATION.RIGHT_ARM"}}</span>
                    <span class="part-ap">{{ap}}</span>
                </div>
                {{/with}}
            </div>
            <div class="body-row legs-row">
                {{#with (lookup armourLocations "left-leg")}}
                <div class="body-part" data-location="left-leg">
                    <span class="part-label">{{localize "BODY_LOCATION.LEFT_LEG"}}</span>
                    <span class="part-ap">{{ap}}</span>
                </div>
                {{/with}}
                {{#with (lookup armourLocations "right-leg")}}
                <div class="body-part" data-location="right-leg">
                    <span class="part-label">{{localize "BODY_LOCATION.RIGHT_LEG"}}</span>
                    <span class="part-ap">{{ap}}</span>
                </div>
                {{/with}}
            </div>
        </div>
        {{/if}}

        <h1>{{localize "TAB.WEAPONS"}}</h1>
        {{#if weapons.length}}
        <ol class="weapon-list">
            {{#each weapons as |w|}}
            {{!-- Shared combat weapon row (bead wiy0): one component for the
                 PC combat tab and the NPC main tab. --}}
            {{> "rt/combat-weapon-row" id=w.id name=w.name classLabel=w.classLabel
                damage=w.damage penetration=w.penetration isRanged=w.isRanged
                rof=w.rof clip=w.clip}}
            {{/each}}
        </ol>
        {{else}}
        <p class="untrained-hint">{{localize "COMBAT.NO_WEAPONS"}}</p>
        {{/if}}
    </div>
</section>