<div class="rogue-trader chat roll">
    <div class="background border">
        <h1>
{{!-- Bead qg4z: the four linking cards (weapon attack, damage, psychic,
     navigator) decompose the title into prefix + name + suffix; the name
     becomes an anchor to the item's compendium doc, and an unresolvable name
     stays plain text. Other roll kinds keep the plain title. --}}
{{#if titleDoc}}
            {{titleDoc.prefix}}{{#if titleDoc.link}}<a class="adv-doc-link" data-action="{{titleDoc.link.action}}" data-uuid="{{titleDoc.link.uuid}}" data-tooltip="{{localize "ADVANCE.OPEN_DOC"}}">{{titleDoc.link.name}}</a>{{else}}{{titleDoc.name}}{{/if}}{{titleDoc.suffix}}
{{else}}
            {{title}}
{{/if}}
        </h1>
        <div class="roll-summary">
            <div class="roll-target">
                <span class="label">{{localize "ROLL.TARGET"}}</span>
                <span class="value">{{target}}</span>
            </div>
            <div class="roll-result {{outcomeClass}}">
                <span class="label">
                    {{outcomeLabel}}
                    {{#if critical}}<strong>({{localize "ROLL.CRITICAL"}})</strong>{{/if}}
                </span>
                <span class="value">{{roll}}</span>
            </div>
        </div>
        {{#if analysis.length}}
        <ul class="modifier-breakdown">
            {{localize "ROLL.MODIFIERS"}}:
            {{#each analysis as |mod|}}
            <li>{{mod.label}}: {{mod.value}}</li>
            {{/each}}
        </ul>
        {{/if}}
        {{#if (and showDamageButton (eq outcomeClass "success"))}}
        <div class="centerBtn">
            <button class="rt-roll-damage">{{localize "CHAT.ROLL_DAMAGE"}}</button>
        </div>
        {{/if}}
    </div>
</div>