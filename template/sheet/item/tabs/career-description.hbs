<section class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
    <div class="stats border">
        {{#if source.system.shortDescription}}
        <p class="career-tagline">{{source.system.shortDescription}}
            <span class="career-source">&mdash; {{source.system.source.book}}, p{{source.system.source.page}}</span></p>
        {{/if}}

        <div class="stats-row">
            <div class="stat full-width">
                <label>{{localize "TITLE.DESCRIPTION"}}</label>
                {{> "rt/rich-text" name="system.description" value=source.system.description
                    html=descriptionHTML editable=editable readonlyClass="description-readonly"}}
            </div>
        </div>
    </div>
</section>