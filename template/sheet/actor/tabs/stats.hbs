<section class="tab {{tabs.data.cssClass}}" data-group="primary" data-tab="data">
    <div class="stats border">
        <h1>{{localize "TITLE.CHARACTERISTICS"}}</h1>
        <div class="characteristics-grid">
            {{#each characteristics as |c|}}
            <div class="characteristic stat">
                <div class="char-inputs">
                    <a class="char-roll" data-action="rollTest" data-key="{{c.key}}"
                        data-tooltip="{{localize "ROLL.MODIFIER"}}" title="{{c.label}}"
                    ><i class="fa-solid fa-dice-d10"></i></a>
                    <label class="char-label" for="char-{{c.key}}">{{localize c.label}}</label>
                    <input id="char-{{c.key}}" class="char-value" name="system.characteristics.{{c.key}}.value"
                        type="number" min="0" max="100" value="{{c.value}}" data-tooltip="{{c.label}}" />
                    <input class="char-bonus" title="{{c.bonusTooltip}}" disabled type="text"
                        value="+{{c.bonus}}" />
                    <span class="unnatural-pips {{#if (gt c.unnatural 1)}}has-mult{{/if}}">
                        {{#each c.pips as |pip|}}
                        <button type="button" class="pip {{#if pip.lit}}lit{{/if}}"
                            data-action="setUnnatural" data-key="{{c.key}}"
                            data-value="{{pip.value}}" data-tooltip="{{c.unnaturalTooltip}}"
                        ></button>
                        {{/each}}
                    </span>
                </div>
            </div>
            {{/each}}
        </div>

        <div class="stat-footer">
            <div class="stat-chip">
                <span class="chip-label">{{localize "TITLE.WOUNDS"}}</span>
                <div class="chip-value">
                    <input name="system.wounds.value" type="number" min="0" value="{{source.system.wounds.value}}" />
                    <span class="chip-sep">/</span>
                    <input name="system.wounds.max" type="number" min="0" value="{{source.system.wounds.max}}" />
                </div>
            </div>
            {{#if isPC}}
            <div class="stat-chip">
                <span class="chip-label">{{localize "CHARACTER.FATE"}}</span>
                <div class="chip-value">
                    <input name="system.fate.value" type="number" min="0" value="{{source.system.fate.value}}" />
                    <span class="chip-sep">/</span>
                    <input name="system.fate.max" type="number" min="0" value="{{source.system.fate.max}}" />
                </div>
            </div>
            {{else}}
            <div class="stat-chip">
                <span class="chip-label">{{localize "NPC.THREAT_LEVEL"}}</span>
                <div class="chip-value">
                    <input name="system.threatLevel" type="text" value="{{source.system.threatLevel}}" />
                </div>
            </div>
            {{/if}}
            <div class="stat-chip">
                <span class="chip-label">{{localize "CHARACTER.FATIGUE"}}</span>
                <div class="chip-value">
                    <input name="system.fatigue" type="number" min="0" value="{{source.system.fatigue}}" />
                </div>
            </div>
            {{#if isPC}}
            <div class="stat-chip">
                <span class="chip-label">{{localize "CHARACTER.INSANITY"}}</span>
                <div class="chip-value">
                    <input name="system.insanity" type="number" min="0" value="{{source.system.insanity}}" />
                </div>
            </div>
            <div class="stat-chip">
                <span class="chip-label">{{localize "CHARACTER.CORRUPTION"}}</span>
                <div class="chip-value">
                    <input name="system.corruption" type="number" min="0" value="{{source.system.corruption}}" />
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</section>