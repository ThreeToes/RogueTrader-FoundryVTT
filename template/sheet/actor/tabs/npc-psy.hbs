<section class="tab {{tabs.psy.cssClass}}" data-group="primary" data-tab="psy">
    <div class="npc border">
        <h1>{{localize "NPC.TAB_PSY"}}</h1>
        {{#if powers.length}}
        <div class="inv-list">
            {{#each powers as |p|}}
            {{#> "rt/inv-row" id=p.id name=p.name uuid=p.uuid}}
            <button type="button" class="ladder-option" data-action="rollNpcPower"
                data-tooltip="{{localize "NPC.ROLL_POWER"}}">{{localize "NPC.ROLL"}}</button>
            {{/"rt/inv-row"}}
            {{/each}}
        </div>
        {{else}}
        <p class="method-hint">{{localize "NPC.POWERS_EMPTY"}}</p>
        {{/if}}
    </div>
</section>