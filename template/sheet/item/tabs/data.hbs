<section class="tab {{tabs.data.cssClass}}" data-group="primary" data-tab="data">
    <div class="stats border">
        <h1>{{localize "TITLE.STATS"}}</h1>
        <div class="stats-row">
            <div class="stat craftsmanship">
                <label>{{localize "GEAR.CRAFTSMANSHIP"}}</label>
                {{#if editable}}
                <select name="system.craftsmanship">
                    {{selectOptions (config "craftsmanship") selected=source.system.craftsmanship localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "craftsmanship") source.system.craftsmanship)}}</p>
                {{/if}}
            </div>
            <div class="stat availability">
                <label>{{localize "GEAR.AVAILABILITY"}}</label>
                {{#if editable}}
                <select name="system.availability">
                    {{selectOptions (config "availability") selected=source.system.availability localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "availability") source.system.availability)}}</p>
                {{/if}}
            </div>
            <div class="stat equip-state">
                <label>{{localize "GEAR.EQUIP_STATE"}}</label>
                {{#if editable}}
                <select name="system.equipState">
                    {{selectOptions (config "equipStates") selected=source.system.equipState localize=true}}
                </select>
                {{else}}
                <p class="static-value">{{localize (lookup (config "equipStates") source.system.equipState)}}</p>
                {{/if}}
            </div>
            <div class="stat weight">
                <label>{{localize "GEAR.WEIGHT"}}</label>
                {{#if editable}}
                <input name="system.weight" type="number" value="{{source.system.weight}}" />
                {{else}}
                <p class="static-value">{{source.system.weight}}</p>
                {{/if}}
            </div>
        </div>
        {{#if editable}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                <label>{{localize "EFFECTS.LIST"}}</label>
                <p class="untrained-hint">{{localize "EFFECTS.HINT"}}</p>
                <div class="effect-add-row">
                    <a data-action="addEffect"><i class="fas fa-plus"></i> {{localize "EFFECTS.ADD"}}</a>
                </div>
        {{#each source.system.effects as |effect i|}}
        <div class="stats-row">
            <select name="system.effects.{{i}}.kind"
                data-tooltip="{{localize "EFFECTS.KIND_HINT"}}">
                {{selectOptions ../kindChoices selected=effect.kind}}
            </select>
            <select name="system.effects.{{i}}.testKey"
                data-tooltip="{{localize "EFFECTS.TEST_KEY_HINT"}}">
                {{selectOptions ../testKeyChoices selected=effect.testKey}}
            </select>
            <input name="system.effects.{{i}}.value" type="number" value="{{effect.value}}"
                data-tooltip="{{localize "EFFECTS.VALUE_HINT"}}" />
            <input name="system.effects.{{i}}.label" type="text" value="{{effect.label}}"
                data-tooltip="{{localize "ROLL.LABEL"}}" />
            <a class="effect-remove" data-action="removeEffect" data-index="{{i}}"
                title="{{localize "EFFECTS.REMOVE"}}"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
            </div>
        </div>
        {{else}}
        {{#if source.system.effects.length}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                <label>{{localize "EFFECTS.LIST"}}</label>
                <ul class="static-effects">
                    {{#each source.system.effects as |effect|}}
                    <li>{{effect.label}} ({{effect.kind}}{{#if effect.testKey}}: {{effect.testKey}}{{/if}}) {{#if (gt effect.value 0)}}+{{/if}}{{effect.value}}</li>
                    {{/each}}
                </ul>
            </div>
        </div>
        {{else}}
        <div class="stats-row">
            <div class="stat item-effects full-width">
                <label>{{localize "EFFECTS.LIST"}}</label>
                <p class="untrained-hint">{{localize "EFFECTS.NONE"}}</p>
            </div>
        </div>
        {{/if}}
        {{/if}}
    </div>
</section>