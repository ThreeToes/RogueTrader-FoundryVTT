<section class="tab {{tabs.data.cssClass}}" data-group="primary" data-tab="data">
    <div class="stats border">
        <h1>{{localize "TITLE.STATS"}}</h1>
        <div class="armour-points">
            <h2>{{localize "ARMOUR.ARMOUR_POINTS"}}</h2>
            <div class="ap-grid">
                {{#each (config "bodyLocations") as |label key|}}
                <div class="ap-cell">
                    <label for="ap-{{key}}">{{localize label}}</label>
                    <input id="ap-{{key}}" name="system.armourPoints.{{key}}" type="number" min="0"
                        value="{{lookup ../armourPoints key}}" />
                </div>
                {{/each}}
            </div>
        </div>
        <div class="stats-row">
            <div class="stat protection-type">
                <label>{{localize "ARMOUR.PROTECTION_TYPE"}}</label>
                <select name="system.protectionType">
                    {{selectOptions (config "protectionTypes") selected=source.system.protectionType localize=true}}
                </select>
            </div>
            <div class="stat max-agility">
                <label>{{localize "ARMOUR.MAX_AGILITY"}}</label>
                <input name="system.maxAgility" type="number" value="{{source.system.maxAgility}}" />
            </div>
        </div>
        <div class="stats-row">
            <div class="stat craftsmanship">
                <label>{{localize "GEAR.CRAFTSMANSHIP"}}</label>
                <select name="system.craftsmanship">
                    {{selectOptions (config "craftsmanship") selected=source.system.craftsmanship localize=true}}
                </select>
            </div>
            <div class="stat availability">
                <label>{{localize "GEAR.AVAILABILITY"}}</label>
                <select name="system.availability">
                    {{selectOptions (config "availability") selected=source.system.availability localize=true}}
                </select>
            </div>
            <div class="stat weight">
                <label>{{localize "GEAR.WEIGHT"}}</label>
                <input name="system.weight" type="number" value="{{source.system.weight}}" />
            </div>
        </div>
        <div class="stats-row">
            <div class="stat short-description">
                <label>{{localize "GEAR.SHORT_DESCRIPTION"}}</label>
                <input name="system.shortDescription" type="text" value="{{source.system.shortDescription}}" />
            </div>
        </div>
    </div>
</section>