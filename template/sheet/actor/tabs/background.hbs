<section class="tab {{tabs.background.cssClass}}" data-group="primary" data-tab="background">
    <div class="background border">
        {{#if hasOrigins}}
        <div class="inv-group-header">
            <h1>{{localize "BACKGROUND.ORIGINS"}}</h1>
        </div>
        <ol class="origin-list">
            {{#each originRows as |row|}}
            <li class="origin-entry">
                <span class="origin-label">{{localize row.labelKey}}:</span>
                <span class="origin-name" data-tooltip="{{row.pick.tooltip}}">{{row.pick.name}}</span>
                {{#each row.pick.mods as |mod|}}
                <span class="chip origin-mod">{{mod}}</span>
                {{/each}}
            </li>
            {{/each}}
        </ol>
        {{/if}}

        <div class="inv-group-header">
            <h1>{{localize "BACKGROUND.CAREER"}}</h1>
            {{#if careerItemId}}
            <button type="button" class="ladder-option" data-action="openCareerSheet" data-item-id="{{careerItemId}}"
                data-tooltip="{{localize "BACKGROUND.OPEN_CAREER"}}">
                <i class="fa-solid fa-book-open"></i> {{localize "BACKGROUND.OPEN_CAREER"}}
            </button>
            {{/if}}
        </div>
        <p class="background-career">
            <span class="origin-label">{{localize "CHARACTER.CAREER"}}:</span>
            <span class="origin-name">{{careerLabel}}</span>
            {{#if careerItemId}}<em class="origin-label">({{localize "BACKGROUND.CAREER_LINKED"}})</em>{{/if}}
        </p>

        <div class="inv-group-header">
            <h1>{{localize "TAB.TALENTS"}}</h1>
            <button type="button" class="ladder-option" data-action="openTalentPicker">
                <i class="fas fa-plus"></i> {{localize "TALENT.ADD"}}
            </button>
        </div>
        {{#if talentRows.length}}
        <ol class="inv-list">
            {{#each talentRows as |item|}}
            <li class="inv-row draggable" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}">
                <span class="inv-grab"><i class="fa-solid fa-grip-vertical"></i></span>
                <span class="inv-name" data-action="openItem" data-tooltip="{{localize "GEAR.OPEN_SHEET"}}">{{item.name}}</span>
                <a class="inv-delete" data-action="deleteItem" data-tooltip="{{localize "GEAR.DELETE"}}"
                ><i class="fa-solid fa-xmark"></i></a>
            </li>
            {{/each}}
        </ol>
        {{else}}
        <p class="untrained-hint">{{localize "TALENT.NONE"}}</p>
        {{/if}}
    </div>
</section>