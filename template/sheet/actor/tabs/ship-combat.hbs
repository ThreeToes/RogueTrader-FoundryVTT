<section class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
    <div class="starship border">
        {{!-- Vitals strip (bead ecnp): the test-dialog target-strip pattern —
             gold small-caps label over a big number, thin vertical rules.
             Void Shields render as pips (one per shield, all lit). --}}
        <div class="sc-vitals-strip">
            <div class="stat">
                <label>{{localize "STARSHIP.HULL_INTEGRITY"}}</label>
                <span class="value">{{combat.hullIntegrity.value}}<span class="sc-vitals-max">/{{combat.hullIntegrity.max}}</span></span>
            </div>
            <div class="stat shields">
                <label>{{localize "SHIP_COMBAT.VOID_SHIELDS"}}</label>
                <span class="pips">{{#each combat.voidShieldPips}}<span class="pip lit"></span>{{/each}}{{#if (eq combat.voidShields 0)}}<span class="value">0</span>{{/if}}</span>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_POPULATION"}}</label>
                <span class="value">{{combat.crewPopulation}}</span>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_MORALE"}}</label>
                <span class="value">{{combat.crewMorale}}</span>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_SKILL"}}</label>
                <span class="value">{{combat.crewSkill}}</span>
            </div>
        </div>

        {{!-- State banner (bead ecnp): colour-coded alarm/warn row under the
             strip instead of prose. Crippled (0 Hull, book p221) is the
             alarm case; depressurised weapons are the warn case. --}}
        {{#if combat.crippled.crippled}}
        <div class="sc-state-banner alarm">⚠ {{localize "SHIP_COMBAT.CRIPPLED"}} — {{localize "SHIP_COMBAT.CRIPPLED_EFFECTS"}}</div>
        {{/if}}

        {{!-- Combat controls toolbar (bead t2bj): Roll Initiative + the
             Helmsman pick + Silent Running share ONE flex row (the
             .traits-row vocabulary) so the controls stop stacking
             full-width on the crowded tab. Every control keeps its own
             class, click action and tooltip hint. --}}
        <div class="traits-row sc-combat-toolbar">
            {{!-- Starship initiative (bead qkq1, Core Rulebook p212-213):
                 1d10 + the Detection tens digit into the active tracker. --}}
            <button type="button" class="rtk-button sc-initiative" data-action="rollInitiative"
                data-tooltip="{{localize "COMBAT.ROLL_INITIATIVE_HINT_SHIP"}}">{{localize "COMBAT.ROLL_INITIATIVE"}}</button>

            {{!-- Helmsman picker (epic necp bead 7gcm, owner decision 1): the
                 performer of the combined test — ship rolls enter with the picked
                 Explorer; unset falls through to the crew-quality skill (Table
                 8-9). The STATE lives on the sheet, not the actor (setHelmsman
                 writes the sheet field). The empty option IS the fallback row. --}}
            <div class="traits-row sc-helmsman">
                <span class="origin-label">{{localize "SHIP_COMBAT.HELMSMAN"}}:</span>
                <select data-action="setHelmsman" data-tooltip="{{localize "SHIP_COMBAT.HELMSMAN_HINT"}}">
                    <option value=""{{#unless combat.helmsman.uuid}} selected{{/unless}}>{{localize "SHIP_COMBAT.HELMSMAN_NONE"}}</option>
                    {{#each combat.helmsman.options as |o|}}
                    <option value="{{o.uuid}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>
                    {{/each}}
                </select>
            </div>

            {{!-- Silent Running toggle (owner decision 8, Core Rulebook p218) --}}
            <div class="traits-row sc-silent-running">
                <button type="button" class="rtk-button sc-silent-toggle{{#if combat.silentRunning}} engaged{{/if}}"
                    data-action="toggleSilentRunning" aria-pressed="{{#if combat.silentRunning}}true{{else}}false{{/if}}"
                    data-tooltip="{{localize "SHIP_COMBAT.SILENT_RUNNING_HINT"}}">{{localize "SHIP_ACTION.SILENT_RUNNING"}}</button>
            </div>
        </div>

        {{!-- Boarding banner (epic necp bead 7gcm, Core Rulebook p215): the
             locked pair, failed-break-free penalty, the Break Free button
             (the S7 machinery row via the ship-action kind, skipDialog — the
             row owns its own dialog) and the opposed-Command manual reminder
             with the S7 kernel's computed bonus rows (no second maths). --}}
        {{#if combat.boarding.locked}}
        <div class="sc-state-banner alarm sc-boarded">
            <span class="boarded-label">⚓ {{combat.boarding.bannerLabel}}
                {{#if combat.boarding.penalty}}<span class="boarded-penalty">{{combat.boarding.penaltyLabel}}</span>{{/if}}
            </span>
            {{#if combat.boarding.breakFreeRowUuid}}
            <button type="button" class="rtk-button sc-break-free" data-action="shipActionChip"
                data-item-id="{{combat.boarding.breakFreeRowUuid}}" data-skip-dialog="true"
                data-tooltip="{{localize "SHIP_BOARDING.BREAK_FREE_HINT"}}">{{localize "SHIP_COMBAT.BREAK_FREE"}}</button>
            {{/if}}
        </div>
        <div class="sc-command-reminder" data-tooltip="{{combat.boarding.reminderLabel}}">
            <span class="sc-note">{{combat.boarding.reminderLabel}}</span>
            <div class="sc-command-rows">
                <div class="sc-command-side">
                    <h4>{{combat.boarding.rowsLabel}}</h4>
                    {{#each combat.boarding.rows as |r|}}
                    <span class="sc-bonus-row"><span class="value">{{r.display}}</span> {{r.label}}</span>
                    {{/each}}
                </div>
                <div class="sc-command-side">
                    <h4>{{combat.boarding.enemyRowsLabel}}</h4>
                    {{#each combat.boarding.enemyRows as |r|}}
                    <span class="sc-bonus-row"><span class="value">{{r.display}}</span> {{r.label}}</span>
                    {{/each}}
                </div>
            </div>
        </div>
        {{/if}}

        {{!-- Turn-state flags (bead vph0/S2 surface) as bonus/penalty chips --}}
        {{#unless combat.turnFlagsEmpty}}
        <div class="sc-turn-flags" data-tooltip="{{localize "SHIP_COMBAT.TURN_FLAGS"}}">
            {{#each combat.turnFlags as |f|}}
            <span class="sc-flag-chip {{f.kind}}{{#if f.persistent}} persistent{{/if}}"
                data-tooltip="{{f.tooltip}}">{{f.label}} <span class="value">{{f.display}}</span></span>
            {{/each}}
        </div>
        {{/unless}}

        {{!-- SHIP ACTIONS (bead 7gcm): the starship-actions pack rows, --}}
        {{!-- grouped through the S5/S7 dispatch tables; every chip enters --}}
        {{!-- the S1 ship-action roll kind, with the helmsman as performer. --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "SHIP_COMBAT.SHIP_ACTIONS"}}</h2>
            <span class="actions-header-actions">
                <button type="button" class="rtk-button sc-default-manoeuvre" data-action="defaultManoeuvre"
                    data-tooltip="{{localize "SHIP_ACTION.DEFAULT_MANOEUVRE_TITLE"}}">{{localize "SHIP_ACTION.DEFAULT_MANOEUVRE_TITLE"}}</button>
            </span>
        </div>
        {{#unless combat.shipActionGroupsEmpty}}
        {{#each combat.shipActionGroups as |group|}}
        <h3 class="inv-group-label">{{localize group.labelKey}}</h3>
        <ol class="sc-action-list action-list">
            {{#each group.rows as |row|}}
            <li class="action-row">
                <a class="action-chip" data-action="shipActionChip" data-item-id="{{row.uuid}}"{{#if row.skipDialog}} data-skip-dialog="true"{{/if}}
                    data-tooltip="{{row.tooltip}}">
                    <i class="fa-solid fa-dice-d10 action-roll-hint"></i>
                    <span class="action-name">{{row.name}}</span>
                </a>
            </li>
            {{/each}}
        </ol>
        {{/each}}
        {{else}}
        <p class="method-hint">{{localize "SHIP_COMBAT.NO_SHIP_ACTIONS"}}</p>
        {{/unless}}

        {{!-- Weapons: fire action per installed ship-weapon-component --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "SHIP_COMBAT.WEAPONS"}}</h2>
            <span class="acq-group-count">{{combat.weapons.length}}</span>
        </div>
        {{#if combat.weapons.length}}
        <div class="sc-battery">
            {{#each combat.weapons as |w|}}
            <div class="battery-card" data-item-id="{{w.id}}">
                <div class="card-head">
                    {{!-- Bead t2bj: the slot renders ONLY when assigned — the
                         unassigned case is the single .sc-state.no-slot badge
                         below (the card-slot badge repeated the same string). --}}
                    <span class="card-name" data-action="openItem" data-item-id="{{w.id}}"
                        data-tooltip="{{localize "GEAR.OPEN_SHEET"}}">{{w.name}}</span>
                    {{#if w.slot}}<span class="card-slot">{{localize w.slotLabel}} {{w.slot}}</span>{{/if}}
                </div>
                <div class="card-badges">
                    {{#if (ne w.state "intact")}}
                    <span class="sc-state {{w.state}}">{{w.stateLabel}}</span>
                    {{/if}}
                    {{#if w.depressurised}}
                    <span class="sc-state depressurised">{{localize "SHIP_COMBAT.DEPRESSURISED"}}</span>
                    {{/if}}
                    {{#if (not w.slot)}}
                    <span class="sc-state no-slot">{{localize w.slotLabel}}</span>
                    {{/if}}
                </div>
                <div class="card-stats">
                    <span class="stat"><label>{{localize "SHIP_COMBAT.STRENGTH"}}</label><span class="value">{{w.strength}}</span></span>
                    <span class="stat"><label>{{localize "SHIP_COMBAT.DAMAGE"}}</label><span class="value">{{w.damage}}</span></span>
                    <span class="stat"><label>{{localize "SHIP_COMBAT.CRIT"}}</label><span class="value">{{w.critRating}}</span></span>
                    <span class="stat"><label>{{localize "SHIP_COMBAT.RANGE"}}</label><span class="value">{{w.rangeLabel}}</span></span>
                </div>
                <button type="button" class="rtk-button sc-fire" data-action="fireWeapon" data-item-id="{{w.id}}"
                    {{#if w.salvo}}{{#if (ne w.state "intact")}}disabled{{/if}}
                    data-tooltip="{{localize "SHIP_COMBAT.FIRE_TOOLTIP"}}"
                    {{else}}disabled
                    data-tooltip="{{localize "SHIP_COMBAT.NOT_A_SALVO_WEAPON"}}"
                    {{/if}}>
                    {{localize "SHIP_COMBAT.FIRE"}}
                </button>
            </div>
            {{/each}}
        </div>
        {{else}}
        <p class="method-hint">{{localize "SHIP_COMBAT.NO_WEAPONS"}}</p>
        {{/if}}

        {{!-- Component roster (bead uc08, round 2 per owner): ONE merged
             list, split by component type so names get the space the type
             badge used to eat. The status badge is OMITTED here because the
             GM state select shows the same information — the select itself
             carries the state colour (duplicate 'Intact' removed). --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "SHIP_COMBAT.CONDITIONS"}}</h2>
            <span class="acq-group-count">{{combat.roster.length}}</span>
        </div>
        {{#if combat.roster.length}}
        <h3 class="inv-group-label">{{localize "SHIP_COMBAT.ROSTER_COMPONENTS"}}</h3>
        {{#each combat.roster as |c|}}
        {{#> "rt/ship-component-row" id=c.id name=c.name stateLabel="" cost=c.cost}}
        {{#if c.repairable}}
        <button type="button" class="rtk-button sc-repair" data-action="repairComponent" data-item-id="{{c.id}}"
            data-tooltip="{{localize "SHIP_COMBAT.REPAIR_TOOLTIP"}}">
            {{localize "SHIP_COMBAT.REPAIR"}}
        </button>
        {{/if}}
        <span class="sc-state-chips" role="group"
            data-tooltip="{{localize "SHIP_COMBAT.STATE_HINT"}}">
            {{#each @root.combat.componentStates as |label key|}}
            <button type="button" class="chip state-chip {{key}}{{#if (eq c.state key)}} checked{{/if}}"
                data-action="setComponentState" data-item-id="{{c.id}}" data-state="{{key}}"
                aria-pressed="{{#if (eq c.state key)}}true{{else}}false{{/if}}">{{label}}</button>
            {{/each}}
        </span>
        {{/"rt/ship-component-row"}}
        {{/each}}
        {{/if}}
        {{#if combat.weaponRoster.length}}
        <h3 class="inv-group-label">{{localize "SHIP_COMBAT.ROSTER_WEAPONS"}}</h3>
        {{#each combat.weaponRoster as |c|}}
        {{#> "rt/ship-component-row" id=c.id name=c.name stateLabel="" cost=c.cost}}
        {{#if c.repairable}}
        <button type="button" class="rtk-button sc-repair" data-action="repairComponent" data-item-id="{{c.id}}"
            data-tooltip="{{localize "SHIP_COMBAT.REPAIR_TOOLTIP"}}">
            {{localize "SHIP_COMBAT.REPAIR"}}
        </button>
        {{/if}}
        <span class="sc-state-chips" role="group"
            data-tooltip="{{localize "SHIP_COMBAT.STATE_HINT"}}">
            {{#each @root.combat.componentStates as |label key|}}
            <button type="button" class="chip state-chip {{key}}{{#if (eq c.state key)}} checked{{/if}}"
                data-action="setComponentState" data-item-id="{{c.id}}" data-state="{{key}}"
                aria-pressed="{{#if (eq c.state key)}}true{{else}}false{{/if}}">{{label}}</button>
            {{/each}}
        </span>
        {{/"rt/ship-component-row"}}
        {{/each}}
        {{/if}}
    </div>
</section>