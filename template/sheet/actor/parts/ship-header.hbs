<div class="header border">
    <div class="header-grid">
        <div class="header-portrait">
            {{> "rt/header-portrait"}}
        </div>
        <div class="header-line line-1">
            <div class="header-cell">
                <label>{{localize "STARSHIP.NAME"}}</label>
                <input name="name" type="text" value="{{document.name}}" />
            </div>
            <div class="header-cell">
                <label>{{localize "STARSHIP.HULL_CLASS"}}</label>
                <input name="system.hullClass" type="text" value="{{source.system.hullClass}}" />
            </div>
        </div>
    </div>
</div>