#!/bin/sh
# Pre-commit hook mirroring the FULL verification sequence of
# .forgejo/workflows/ci.yaml (bead qdmc; full-parity extension 2026-10-20
# after packless-CI failures leaked through the pre-build hook gap).
# Install once per clone with: bun run hooks:install
#
# Checks: typecheck (pure + scoped), lint, bun test, verify:templates, build.
#
# The hook runs the same steps and order as ci.yaml, PLUS a packless parity
# pass (bead 0qyi, option a): the hook sees src/packs, CI does not, and the
# 2026-10-22 CI red was a test that failed only then (afflictions pack
# guard). Two closures: (1) utils/pack-read-guard.test.ts fails `bun test`
# when a src/ or utils/ suite reads a src/packs path at runtime with no
# skipIf/existsSync guard (static, fast — catches the direct-read class);
# (2) the packless pass below runs `bun test` in a throwaway worktree with
# NO src/packs, which is the CI condition exactly — it closes the class at
# any layer, including helper-indirection reads the static guard cannot see
# (the 2026-10-25 CI red was emit-careers-yaml's keyAdvance reading the
# packs from inside a helper). The packless suite is small (pack-dependent
# tests skip) and runs in ~1-2s. New pack-driven tests must use the skipIf
# guard shape of rules/origins.test.ts. Bypass with: git commit --no-verify.
set -eu

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "==> bun run typecheck (pure + scoped)"
if bun run typecheck; then echo "    typecheck OK"; else echo "    typecheck FAILED"; fail=1; fi

echo "==> bun run lint"
if bun run lint; then echo "    lint OK"; else echo "    lint FAILED"; fail=1; fi

echo "==> bun test"
if bun test; then echo "    bun test OK"; else echo "    bun test FAILED"; fail=1; fi

echo "==> bun run verify:templates"
if bun run verify:templates; then echo "    verify:templates OK"; else echo "    verify:templates FAILED"; fail=1; fi

echo "==> bun run build"
if bun run build; then echo "    build OK"; else echo "    build FAILED"; fail=1; fi

echo "==> packless parity pass (CI condition: no src/packs)"
PACKLESS_WORKTREE="$(mktemp -d)/packless"
PARITY_FAIL=0
if git worktree add --detach "$PACKLESS_WORKTREE" HEAD >/dev/null 2>&1; then
    # node_modules does not exist in a fresh worktree; symlink this
    # checkout's — same bun/binary, same packages.
    ln -s "$(pwd)/node_modules" "$PACKLESS_WORKTREE/node_modules"
    if (cd "$PACKLESS_WORKTREE" && bun test); then
        echo "    packless bun test OK"
    else
        echo "    packless bun test FAILED (CI would fail: this run had no src/packs)"
        PARITY_FAIL=1
    fi
    git worktree remove --force "$PACKLESS_WORKTREE" >/dev/null 2>&1 || \
        rm -rf "$PACKLESS_WORKTREE"
    [ "$PARITY_FAIL" -eq 0 ] || fail=1
else
    echo "    skipped (worktree add failed — parity not verified this commit)"
fi

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "pre-commit checks FAILED — commit refused."
    echo "To bypass (discouraged): git commit --no-verify"
    exit 1
fi

echo ""
echo "All pre-commit checks passed."