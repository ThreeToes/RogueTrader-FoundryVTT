<div class="rogue-trader chat damage">
    <div class="background border">
        <h1>{{title}}</h1>
        {{#if hitSuccess}}
        <div class="damage-body">
            <p class="damage-location">
                <strong>{{localize "WEAPON.DAMAGE_FULL"}}</strong>
                <span class="location-label">{{localize locationLabelKey}}</span>
            </p>
            <p><strong>{{localize "CHAT.DAMAGE"}}:</strong>
                <span class="damage-total">{{damage.rawRoll}}</span>
                {{#if damage.primitiveDouble}}({{localize "CHAT.PRIMITIVE_DOUBLE"}}){{/if}}
                &rarr; <strong class="damage-wounds">{{damage.wounds}}</strong>
                {{localize "WOUNDS.REDUCED"}}
            </p>
            <p><strong>{{localize "WEAPON.PENETRATION_FULL"}}:</strong> {{damage.penApplied}}
                &middot; <strong>{{localize "WOUNDS.ARMOUR"}}</strong> {{damage.effectiveArmour}}
                &middot; <strong>{{localize "WOUNDS.SOAK"}}</strong> {{damage.absorbed}}</p>
            {{#if damage.righteousFury}}
            <p class="righteous-fury"><strong>{{localize "CHAT.RIGHTEOUS_FURY"}}!</strong></p>
            {{/if}}
        </div>
        {{else}}
        <p class="damage-miss">{{localize "DAMAGE.MISS"}}</p>
        {{/if}}
        <p class="damage-note">{{localize "DAMAGE.APPLY_HINT"}}</p>
    </div>
</div>