<section class="tab {{tabs.main.cssClass}}" data-group="primary" data-tab="main">
    <div class="npc border">
        {{!-- Identity row (bead lib6, k4z0 GAP 1): faction/subfaction/type/
             size/threat level. NPC-only fields; PC sheets never bind them. --}}
        <div class="npc-identity">
            <label class="identity-field grow">
                <span>{{localize "NPC.FACTION"}}</span>
                <input name="system.faction" type="text" value="{{source.system.faction}}" />
            </label>
            <label class="identity-field grow">
                <span>{{localize "NPC.SUBFACTION"}}</span>
                <input name="system.subfaction" type="text" value="{{source.system.subfaction}}" />
            </label>
            <label class="identity-field">
                <span>{{localize "NPC.NPC_TYPE"}}</span>
                <input name="system.npcType" type="text" value="{{source.system.npcType}}" />
            </label>
            <label class="identity-field">
                <span>{{localize "NPC.SIZE"}}</span>
                <input name="system.size" type="text" value="{{source.system.size}}" />
            </label>
            <label class="identity-field">
                <span>{{localize "NPC.THREAT_LEVEL"}}</span>
                <input name="system.threatLevel" type="text" value="{{source.system.threatLevel}}" />
            </label>
        </div>

        {{!-- Horizontal characteristic table: shorts row + values row, click to roll --}}
        <table class="npc-chars">
            <thead>
                <tr>
                    {{#each characteristics as |c|}}
                    <th>{{c.short}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                <tr>
                    {{#each characteristics as |c|}}
                    <td><a class="npc-char-roll" data-action="rollNpcTest" data-key="{{c.key}}">{{c.value}}</a></td>
                    {{/each}}
                </tr>
            </tbody>
        </table>

        {{!-- Known-or-better skills (ladder >= 1); number = roll bonus.
             Shared inventory line (bead npc-parity): leading roll anchor +
             name + ladder select + delete via the rt/inv-row vocabulary. --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "NPC.SKILLS"}}</h2>
        </div>
        {{#if skills.length}}
        <div class="inv-list">
            {{#each skills as |s|}}
            {{#> "rt/inv-row" id=s.id name=s.name
                leadingIcon="fa-solid fa-dice-d10" leadingAction="rollNpcSkill" leadingTooltip=s.name
                deleteAction="deleteNpcSkill" deleteTooltip=(localize "NPC.DELETE_SKILL")}}
                {{#if ../editable}}
                <select class="npc-ladder-select" data-item="{{s.id}}"
                    data-tooltip="{{localize "NPC.LADDER_TOOLTIP"}}">
                    {{selectOptions s.ladderOptions selected=s.ladder localize=true}}
                </select>
                {{else}}
                <span class="acq-group-count">{{s.bonus}}</span>
                {{/if}}
            {{/"rt/inv-row"}}
            {{/each}}
        </div>
        {{else}}
        <p class="method-hint">{{localize "NPC.SKILLS_EMPTY"}}</p>
        {{/if}}

        {{!-- Combat rolls: owned weapons on the shared inventory line --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "NPC.COMBAT"}}</h2>
        </div>
        {{#if weapons.length}}
        <div class="inv-list">
            {{#each weapons as |w|}}
            {{#> "rt/inv-row" id=w.id name=w.name
                equipToggle=true equipped=w.equipped equipAction="toggleNpcEquip"
                equipTooltip=(ifThen w.equipped (localize "NPC.STOW") (localize "NPC.EQUIP"))}}
                <span class="chip origin-mod">{{w.damage}}</span>
                <button type="button" class="ladder-option" data-action="rollNpcWeapon"
                    data-tooltip="{{localize "NPC.ROLL_ATTACK"}}">{{localize "NPC.ATTACK"}}</button>
                <button type="button" class="ladder-option" data-action="rollNpcDamage"
                    data-tooltip="{{localize "NPC.ROLL_DAMAGE"}}">{{localize "NPC.DAMAGE"}}</button>
            {{/"rt/inv-row"}}
            {{/each}}
        </div>
        {{else}}
        <p class="method-hint">{{localize "NPC.COMBAT_EMPTY"}}</p>
        {{/if}}
    </div>
</section>