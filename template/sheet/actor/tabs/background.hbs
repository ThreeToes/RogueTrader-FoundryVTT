<section class="tab {{tabs.background.cssClass}}" data-group="primary" data-tab="background">
    <div class="background border">
        {{#if hasOrigins}}
        <div class="inv-group-header">
            <h1>{{localize "BACKGROUND.ORIGINS"}}</h1>
        </div>
        <ol class="origin-list">
            {{#each originRows as |row|}}
            <li class="origin-entry">
                <span class="origin-label">{{localize row.labelKey}}:</span>
                <span class="origin-name" data-tooltip="{{row.pick.tooltip}}">{{row.pick.name}}</span>
                {{#each row.pick.mods as |mod|}}
                <span class="chip origin-mod">{{mod}}</span>
                {{/each}}
            </li>
            {{/each}}
        </ol>
        {{/if}}

        {{#if hasTraits}}
        <div class="origin-traits">
            {{#if traitModifiers.length}}
            <div class="traits-row">
                <span class="origin-label">{{localize "BACKGROUND.TRAIT_MODIFIERS"}}</span>
                {{#each traitModifiers as |t|}}
                <a class="chip origin-mod" data-tooltip="{{t.tooltip}}">{{t.name}} ({{#if (gt t.value 0)}}+{{/if}}{{t.value}}{{#if t.testKeyLabel}} {{t.testKeyLabel}}{{/if}})</a>
                {{/each}}
            </div>
            {{/if}}
            {{#if traitGrants.length}}
            <div class="traits-row">
                <span class="origin-label">{{localize "BACKGROUND.TRAIT_GRANTS"}}</span>
                {{#each traitGrants as |t|}}
                {{#if t.claimed}}
                <span class="chip claimed" data-tooltip="{{t.tooltip}}"><i class="fa-solid fa-check"></i> {{t.name}}</span>
                {{else if t.resolvable}}
                <a class="chip grant-resolve" data-action="claimGrant" data-key="{{t.key}}" data-resolvable="true"
                    data-tooltip="{{t.tooltip}}">{{t.name}} ({{localize "BACKGROUND.CLAIM"}})</a>
                {{else}}
                <a class="chip grant-ack" data-action="claimGrant" data-key="{{t.key}}"
                    data-tooltip="{{t.tooltip}}">{{t.name}} ({{localize "BACKGROUND.ACK"}})</a>
                {{/if}}
                {{/each}}
            </div>
            {{/if}}
            {{#if traitNotes.length}}
            <div class="traits-row">
                <span class="origin-label">{{localize "BACKGROUND.TRAIT_NOTES"}}</span>
                {{#each traitNotes as |t|}}
                <a class="chip origin-note" data-tooltip="{{t.tooltip}}">{{t.name}}</a>
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/if}}

        {{!-- Dynasty link (owner redesign): attach the character to the group's dynasty record. --}}
        <div class="traits-row">
            <span class="origin-label">{{localize "BACKGROUND.DYNASTY"}}:</span>
            <select name="system.dynastyUuid">
                <option value="">{{localize "BACKGROUND.DYNASTY_NONE"}}</option>
                {{#each dynastyOptions as |d|}}
                <option value="{{d.uuid}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>
                {{/each}}
            </select>
        </div>

        <div class="madness border">
            <div class="inv-group-header">
                <h1>{{localize "MADNESS.HEADER"}}</h1>
                <span class="madness-actions">
                    <button type="button" class="ladder-option" data-action="rollTraumaTest"
                        data-tooltip="{{localize "MADNESS.TRAUMA_HINT"}}">{{localize "MADNESS.TRAUMA_TEST"}}</button>
                    <button type="button" class="ladder-option" data-action="rollMalignancyTest"
                        data-tooltip="{{localize "MADNESS.MALIGNANCY_HINT"}}">{{localize "MADNESS.MALIGNANCY_TEST"}}</button>
                </span>
            </div>
            <div class="traits-row">
                <span class="origin-label">{{localize "MADNESS.INSANITY"}}: {{madness.insanityDegree}}</span>
                <span class="origin-label">{{localize "MADNESS.CORRUPTION"}}: {{madness.corruptionDegree}}</span>
                {{#if madness.dueDisorders.length}}
                <span class="chip grant-ack" data-tooltip="{{localize "MADNESS.DISORDERS_DUE"}}">
                    {{localize "MADNESS.DISORDERS_DUE"}}
                </span>
                {{/if}}
                {{#each madness.afflictions as |a|}}
                <a class="chip origin-note" data-tooltip="{{a.text}}">{{a.name}}</a>
                {{/each}}
            </div>
        </div>

        <div class="inv-group-header">
            <h1>{{localize "BACKGROUND.CAREER"}}</h1>
            {{#if careerItemId}}
            <button type="button" class="ladder-option" data-action="openCareerSheet" data-uuid="{{careerItemId}}"
                data-tooltip="{{localize "BACKGROUND.OPEN_CAREER"}}">
                <i class="fa-solid fa-book-open"></i> {{localize "BACKGROUND.OPEN_CAREER"}}
            </button>
            {{/if}}
        </div>
        <p class="background-career">
            <span class="origin-label">{{localize "CHARACTER.CAREER"}}:</span>
            {{#if careerItemId}}
            <a class="origin-name career-link" data-action="openCareerSheet" data-uuid="{{careerItemId}}"
                data-tooltip="{{localize "BACKGROUND.OPEN_CAREER_TOOLTIP"}}">{{careerLabel}}</a>
            {{else}}
            <span class="origin-name">{{careerLabel}}</span>
            {{/if}}
            {{#if careerItemId}}<em class="origin-label">({{localize "BACKGROUND.CAREER_LINKED"}})</em>{{/if}}
        </p>

        <div class="inv-group-header">
            <h1>{{localize "TAB.TALENTS"}}</h1>
            <button type="button" class="ladder-option" data-action="openTalentPicker">
                <i class="fas fa-plus"></i> {{localize "TALENT.ADD"}}
            </button>
        </div>
        {{#if talentRows.length}}
        <ol class="inv-list">
            {{#each talentRows as |item|}}
            <li class="inv-row draggable" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}">
                <span class="inv-grab"><i class="fa-solid fa-grip-vertical"></i></span>
                <span class="inv-name" data-action="openItem" data-tooltip="{{localize "GEAR.OPEN_SHEET"}}">{{item.name}}</span>
                {{#if item.packUuid}}
                <a class="inv-pack-link" data-action="openPackItem" data-uuid="{{item.packUuid}}"
                    data-tooltip="{{localize "BACKGROUND.OPEN_PACK_TALENT"}}"><i class="fa-solid fa-book-open"></i></a>
                {{/if}}
                <a class="inv-delete" data-action="deleteItem" data-tooltip="{{localize "GEAR.DELETE"}}"
                ><i class="fa-solid fa-xmark"></i></a>
            </li>
            {{/each}}
        </ol>
        {{else}}
        <p class="untrained-hint">{{localize "TALENT.NONE"}}</p>
        {{/if}}
    </div>
</section>