#!/bin/sh
# Pre-commit hook mirroring the FULL verification sequence of
# .forgejo/workflows/ci.yaml (bead qdmc; full-parity extension 2026-10-20
# after packless-CI failures leaked through the pre-build hook gap).
# Install once per clone with: bun run hooks:install
#
# Checks: typecheck (pure + scoped), lint, bun test, verify:templates, build.
#
# The hook runs the same steps and order as ci.yaml. Note the parity
# limitation: the hook runs WITH this checkout's src/packs present, while
# CI has none. A pack-dependent test that fails only when packs are ABSENT
# (a missing skipIf guard on an existsSync read) therefore passes here and
# fails there — the 2026-10-22 CI red was exactly this (afflictions pack
# guard). That class is now caught STATICALLY, not by a second test run:
# utils/pack-read-guard.test.ts fails `bun test` when a src/ or utils/ suite
# reads a src/packs path at runtime with no skipIf/existsSync guard (bead
# 0qyi, option b — a packless parity pass would double the hook's slowest
# step). New pack-driven tests must use the skipIf guard shape of
# rules/origins.test.ts. Bypass with: git commit --no-verify.
set -eu

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "==> bun run typecheck (pure + scoped)"
if bun run typecheck; then echo "    typecheck OK"; else echo "    typecheck FAILED"; fail=1; fi

echo "==> bun run lint"
if bun run lint; then echo "    lint OK"; else echo "    lint FAILED"; fail=1; fi

echo "==> bun test"
if bun test; then echo "    bun test OK"; else echo "    bun test FAILED"; fail=1; fi

echo "==> bun run verify:templates"
if bun run verify:templates; then echo "    verify:templates OK"; else echo "    verify:templates FAILED"; fail=1; fi

echo "==> bun run build"
if bun run build; then echo "    build OK"; else echo "    build FAILED"; fail=1; fi

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "pre-commit checks FAILED — commit refused."
    echo "To bypass (discouraged): git commit --no-verify"
    exit 1
fi

echo ""
echo "All pre-commit checks passed."