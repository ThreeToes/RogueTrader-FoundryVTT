<div class="rogue-trader chat roll">
    <div class="background border">
        <h1>{{title}}</h1>
        <div class="roll-summary">
            {{#if shockRoll}}
            <div class="roll-target">
                <span class="label">{{localize "FEAR.SHOCK_ROLL"}}</span>
                <span class="value">{{shockRoll}}</span>
            </div>
            {{/if}}
            <div class="roll-result failure">
                <span class="label">{{shockText}}</span>
            </div>
            {{#if conditionName}}
            <div class="roll-result">
                <span class="label">{{localize "FEAR.CONDITION_APPLIED"}}:</span>
                <span class="value">{{conditionName}}</span>
            </div>
            {{/if}}
            {{#if insanityGain}}
            <div class="roll-result">
                <span class="label">{{localize "FEAR.INSANITY_GAINED"}}:</span>
                <span class="value">{{insanityGain}}</span>
            </div>
            {{/if}}
            {{#if insanityNote}}
            <div class="roll-result">
                <span class="label">{{insanityNote}}</span>
            </div>
            {{/if}}
        </div>
    </div>
</div>