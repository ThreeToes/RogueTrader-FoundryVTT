{{!-- Record tab (bead twtq): Profit Factor / Ship Points fields, the
     starting roll, the GM's Warrant pickers and the notes. The sheet is
     tabbed now — this is one of seven tab sections in the shared tab
     anatomy (docs/DESIGN-LANGUAGE.md); tabs 2-7 render the read-only
     choice views from the shared dynasty-choice.hbs template.
     The pickers dispatch imperatively via input[data-warrant-row]
     (dynasty-sheet._onRender); keep their markup when editing. --}}
<section class="tab {{tabs.record.cssClass}}" data-group="primary" data-tab="record">
    <div class="dynasty border">
        <div class="traits-row">
            <span class="origin-label">{{localize "DYNASTY.SHIP_POINTS"}}:</span>
            <span class="chip origin-mod">{{shipPointsRemaining}} / {{shipPoints.total}}
                ({{localize "DYNASTY.SPENT"}}: {{shipPoints.spent}})</span>
        </div>
        <div class="stats-row">
            <div class="stat">
                <label>{{localize "DYNASTY.SP_TOTAL"}}</label>
                <input name="system.shipPoints.total" type="number" min="0"
                    value="{{source.system.shipPoints.total}}" />
            </div>
            <div class="stat">
                <label>{{localize "DYNASTY.SP_SPENT"}}</label>
                <input name="system.shipPoints.spent" type="number" min="0"
                    value="{{source.system.shipPoints.spent}}" />
            </div>
        </div>
        <div class="traits-row">
            {{#if editable}}
            <button type="button" class="ladder-option" data-action="rollStarting"
                data-tooltip="{{localize "DYNASTY.ROLL_HINT"}}">{{localize "DYNASTY.ROLL_STARTING"}}</button>
            {{/if}}
        </div>

        <div class="warrant-section">
            <h1 class="inv-group-label">{{localize "DYNASTY.WARRANT"}}</h1>
            {{#if warrantPoolEmpty}}
            <p class="method-hint">{{localize "DYNASTY.WARRANT_POOL_MISSING"}}</p>
            {{else}}
            {{#if editable}}
            <p class="method-hint">{{localize "DYNASTY.WARRANT_HINT"}}</p>
            <div class="warrant-grid">
                {{#each warrantRows as |wr|}}
                <div class="warrant-row">
                    <span class="warrant-row-label">{{wr.label}}</span>
                    <div class="chip-select">
                        <label class="chip-option">
                            <input type="radio" name="warrant-{{wr.row}}" value=""
                                data-warrant-row="{{wr.row}}" {{#unless wr.picked}}checked{{/unless}} />
                            <span class="chip">{{localize "DYNASTY.WARRANT_NONE_PICK"}}</span>
                        </label>
                        {{#each wr.options as |opt|}}
                        <label class="chip-option">
                            <input type="radio" name="warrant-{{wr.row}}" value="{{opt.key}}"
                                data-warrant-row="{{wr.row}}" {{#if opt.selected}}checked{{/if}} />
                            <span class="chip">{{opt.name}}</span>
                        </label>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            {{!-- Players: the recorded path as read-only chips (bead twtq —
                 the sheet is a record, the WarrantCreator does the picking). --}}
            {{#each warrantChoices as |c|}}
            <div class="warrant-row">
                <span class="warrant-row-label">{{localize c.labelKey}}</span>
                {{#if c.name}}
                <span class="chip">{{c.name}}</span>
                {{else if c.pickKey}}
                <span class="chip">{{c.pickKey}}</span>
                {{else}}
                <span class="chip">{{localize "DYNASTY.WARRANT_NONE_PICK"}}</span>
                {{/if}}
            </div>
            {{/each}}
            {{/if}}
            <div class="warrant-footer">
                {{#if warrant.hasPicks}}
                <span class="chip origin-mod">{{localize "DYNASTY.WARRANT_FROM"}}:
                    {{localize "DYNASTY.SHIP_POINTS"}} {{warrant.shipPoints}} /
                    {{localize "DYNASTY.PROFIT_FACTOR"}} {{warrant.profitFactor}}</span>
                {{#if warrant.renown}}
                <span class="chip">{{localize "WARRANT.ROW_RENOWN"}}: {{warrant.renown}}</span>
                {{/if}}
                {{#unless warrant.complete}}
                <span class="method-hint">{{localize "DYNASTY.WARRANT_INCOMPLETE"}}</span>
                {{/unless}}
                {{#if editable}}
                <button type="button" class="ladder-option"
                    data-action="clearWarrant">{{localize "DYNASTY.WARRANT_CLEAR"}}</button>
                {{/if}}
                {{else}}
                <p class="static-value">{{localize "DYNASTY.WARRANT_NONE"}}</p>
                {{/if}}
            </div>
            {{#if warrant.notes.length}}
            <ul class="warrant-notes">
                {{#each warrant.notes as |note|}}<li>{{note}}</li>{{/each}}
            </ul>
            {{/if}}
            {{/if}}
        </div>

        <div class="traits-row">
            <label class="origin-label" for="dynasty-notes">{{localize "DYNASTY.NOTES"}}</label>
        </div>
        {{> "rt/rich-text" name="system.notes" value=source.system.notes html=notesHTML editable=editable}}
    </div>
</section>