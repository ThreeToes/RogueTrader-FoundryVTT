<section class="tab {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
    <div class="inventory border">
        <h1>{{localize "TAB.INVENTORY"}}</h1>

        <div class="encumbrance-bar state-{{encumbrance.state}}">
            <span class="chip-label">{{localize "INVENTORY.CAPACITY"}}</span>
            <a class="capacity-note" data-tooltip="{{localize "INVENTORY.CAPACITY_HINT"}}">
                <i class="fa-solid fa-circle-info"></i>
            </a>
            <div class="encumbrance-progress">
                <div class="bar">
                    <div class="fill" style="width: {{#if encumbrance.capacity}}{{encumbrance.percent}}{{else}}0{{/if}}%"></div>
                </div>
                <span class="encumbrance-text">{{encumbrance.weight}} / {{encumbrance.capacity}} kg ({{encumbrance.percent}}%) {{localize encumbrance.stateLabel}}</span>
            </div>
        </div>

        {{#each inventory as |group|}}
        {{#if group.addLabel}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize group.label}}</h2>
            <button type="button" class="ladder-option" data-action="{{group.addAction}}">
                <i class="fas fa-plus"></i> {{localize group.addLabel}}
            </button>
        </div>
        {{/if}}
        {{#if group.items.length}}
        <h2 class="inv-group-label">{{localize group.label}}</h2>
        <div class="inv-list">
            {{#each group.items as |item|}}
            {{!-- Shared inventory line (bead npc-parity): the equip toggle +
                 optional weapon-roll anchor + name + weight + delete. --}}
            {{#if item.isWeapon}}
            {{#> "rt/inv-row" id=item.id uuid=item.uuid name=item.name draggable=true gripVertical=true
                openItem=true openItemTooltip=(localize "GEAR.OPEN_SHEET")
                equipToggle=true equipped=item.equipped equipAction="toggleEquip" equipTooltip=item.equipStateLabel
                leadingIcon="fa-solid fa-dice-d10" leadingAction="rollWeapon"
                leadingTooltip=(ifThen item.equipped (localize "WEAPON.ATTACK") item.equipStateLabel)
                leadingClasses=(ifThen item.equipped "weapon-roll" "weapon-roll unequipped")
                weight=(concat item.weight " kg") weightTooltip=(localize "GEAR.WEIGHT")
                deleteAction="deleteItem" deleteTooltip=(localize "GEAR.DELETE")}}
            {{/"rt/inv-row"}}
            {{else}}
            {{#> "rt/inv-row" id=item.id uuid=item.uuid name=item.name draggable=true gripVertical=true
                openItem=true openItemTooltip=(localize "GEAR.OPEN_SHEET")
                equipToggle=true equipped=item.equipped equipAction="toggleEquip" equipTooltip=item.equipStateLabel
                weight=(concat item.weight " kg") weightTooltip=(localize "GEAR.WEIGHT")
                deleteAction="deleteItem" deleteTooltip=(localize "GEAR.DELETE")}}
            {{/"rt/inv-row"}}
            {{/if}}
            {{/each}}
        </div>
        {{/if}}
        {{/each}}
    </div>
</section>