<section class="tab {{tabs.refit.cssClass}}" data-group="primary" data-tab="refit">
    <div class="starship border">
        <h1>{{localize "STARSHIP.TAB_REFIT"}}</h1>

        {{!-- Drag-and-drop install (bead pyi3): drag ship-component /
             ship-weapon-component items here from the ships compendium.
             Non-component items are refused with a loud warning. --}}
        <p class="method-hint">{{localize "STARSHIP.DROP_HINT"}}</p>

        {{#each weaponIssues as |issue|}}
        <p class="method-hint warn">⚠ {{localize "STARSHIP.WEAPON_ISSUE"}}: {{issue.name}} —
            {{issue.message}}{{#if issue.slot}} ({{issue.slot}}){{/if}}</p>
        {{/each}}

        {{!-- Installed components: inventory-style, grouped by category --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "STARSHIP.COMPONENTS"}}</h2>
            <span class="acq-group-count">{{components.length}}</span>
        </div>
        {{#if components.length}}
        <div class="starship-components">
            {{#each installedGroups as |group|}}
            <div class="inv-group-header">
                <h3 class="inv-group-label">{{localize group.labelKey}}</h3>
                <span class="acq-group-count">{{group.items.length}}</span>
            </div>
            {{#each group.items as |c|}}
            {{#> "rt/inv-row" id=c.id name=c.name deleteAction="removeComponent" deleteTooltip=(localize "STARSHIP.COMPONENT_REMOVE")}}
            <span class="chip origin-mod">{{localize "WEAPON.POWER"}} {{c.power}}</span>
            <span class="chip origin-mod">{{localize "STARSHIP.SPACE"}} {{c.space}}</span>
            <span class="chip origin-mod">SP {{c.sp}}</span>
            {{#if (eq c.type "ship-weapon-component")}}
            <select data-action="setWeaponSlot" data-item-id="{{c.id}}"
                data-tooltip="{{localize "STARSHIP.SLOT_HINT"}}">
                {{selectOptions ../weaponSlots selected=c.slot localize=true blank="—"}}
            </select>
            {{/if}}
            {{/"rt/inv-row"}}
            {{/each}}
            {{/each}}
        </div>
        {{else}}
        <p class="method-hint">{{localize "STARSHIP.COMPONENTS_EMPTY"}}</p>
        {{/if}}

        {{!-- Demoted browse affordance: the compendium pickers, collapsed by
             default now that drag-and-drop is the primary install path --}}
        <div class="acq-group">
            <button type="button" class="acq-group-header" data-action="toggleComponentGroup" data-group="browse">
                <i class="fa-solid {{#if componentGroupsOpen}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
                {{localize "STARSHIP.BROWSE_COMPONENTS"}}
            </button>
            {{#if componentGroupsOpen}}
            {{#each componentGroups as |group|}}
            {{#if group.items.length}}
            <div class="acq-group">
                <button type="button" class="acq-group-header" data-action="toggleComponentGroup" data-group="{{group.key}}">
                    <i class="fa-solid {{#if group.open}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
                    {{localize group.labelKey}}
                    <span class="acq-group-count">({{group.items.length}})</span>
                </button>
                {{#if group.open}}
                <div class="pick-chips">
                    {{#each group.items as |c|}}
                    <a class="pick-chip" data-action="addComponent" data-uuid="{{c.uuid}}"
                        data-tooltip="{{localize "WEAPON.POWER"}} {{c.power}} · {{localize "STARSHIP.SPACE"}} {{c.space}} · SP {{c.sp}}">{{c.name}}</a>
                    {{/each}}
                </div>
                {{/if}}
            </div>
            {{/if}}
            {{/each}}
            {{/if}}
        </div>

        {{!-- Hull picker: apply a ships-pack hull to this actor --}}
        <div class="inv-group-header">
            <h2 class="inv-group-label">{{localize "STARSHIP.PICK_HULL"}}</h2>
            <span class="acq-group-count">{{hullOptions.length}}</span>
        </div>
        <div class="pick-chips">
            {{#each hullOptions as |h|}}
            <a class="pick-chip {{#if (eq h.name ../system.hullName)}}selected{{/if}}"
                data-action="pickHull" data-uuid="{{h.uuid}}">{{h.name}} ({{h.sp}} SP)</a>
            {{/each}}
        </div>
    </div>
</section>