<div class="header compact npc-header border">
    <img class="profile-img" src="{{document.img}}" data-action="editImage" data-field="img"
        alt="{{document.name}}" title="{{document.name}}" />
    <div class="name header-cell grow">
        {{#if editable}}
        <div class="npc-name-row">
            <input class="name-input" name="name" type="text" value="{{document.name}}" />
            <div class="paired npc-wounds">
                <input class="wound-box" name="system.wounds.value" type="number" min="0"
                    value="{{system.wounds.value}}" />
                <span class="pair-sep">/</span>
                <input class="wound-box" name="system.wounds.max" type="number" min="0"
                    value="{{system.wounds.max}}" />
            </div>
        </div>
        <input class="short-description" name="system.shortDescription" type="text"
            value="{{system.shortDescription}}" placeholder="{{localize "GEAR.SHORT_DESCRIPTION"}}" />
        {{else}}
        <div class="npc-name-row">
            <p class="name-input static-value">{{document.name}}</p>
            <p class="static-value">{{system.wounds.value}} / {{system.wounds.max}}</p>
        </div>
        {{#if system.shortDescription}}
        <p class="short-description static-value">{{system.shortDescription}}</p>
        {{/if}}
        {{/if}}
    </div>
</div>