<section class="tab {{tabs.hull.cssClass}}" data-group="primary" data-tab="hull">
    <div class="starship border">
        {{!-- The hull snapshot line lives in the header now (owner round 5). --}}

        {{!-- Statline: three side-by-side groups (Drive / Resilience / Crew)
              then a full-width Resources group — owner option A, no ragged
              rows. --}}
        <div class="stat-groups">
        <div class="stat-group">
            <h3 class="inv-group-label">{{localize "STARSHIP.GROUP_DRIVE"}}</h3>
            <div class="stat-grid">
            <div class="stat">
                <label>{{localize "STARSHIP.SPEED"}}</label>
                <input name="system.speed" type="number" min="0" value="{{system.speed}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.MANOEUVRAABILITY"}}</label>
                <input name="system.manoeuvrability" type="number" value="{{system.manoeuvrability}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.DETECTION"}}</label>
                <input name="system.detection" type="number" value="{{system.detection}}" />
            </div>
            </div>
        </div>
        <div class="stat-group">
            <h3 class="inv-group-label">{{localize "STARSHIP.GROUP_RESILIENCE"}}</h3>
            <div class="stat-grid">
            <div class="stat">
                <label>{{localize "STARSHIP.HULL_INTEGRITY"}}</label>
                <div class="composite">
                    <input name="system.hullIntegrity.value" type="number" min="0" value="{{system.hullIntegrity.value}}" />
                    <span class="sep">/</span>
                    <span class="chip origin-mod">{{system.hullIntegrity.max}}</span>
                </div>
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.ARMOUR"}}</label>
                <input name="system.armour" type="number" min="0" value="{{system.armour}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.TURRET_RATING"}}</label>
                <input name="system.turretRating" type="number" min="0" value="{{system.turretRating}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.VOID_SHIELDS"}}</label>
                <div class="composite">
                    <input name="system.voidShields" type="number" min="0" value="{{system.voidShields}}" />
                    <span class="sep">/</span>
                    <span class="chip origin-mod">{{derived.voidShieldsMax}}</span>
                </div>
            </div>
            </div>
        </div>
        <div class="stat-group">
            <h3 class="inv-group-label">{{localize "STARSHIP.GROUP_CREW"}}</h3>
            <div class="stat-grid">
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_POPULATION"}}</label>
                <input name="system.crewPopulation" type="number" min="0" max="100" value="{{system.crewPopulation}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_MORALE"}}</label>
                <input name="system.crewMorale" type="number" min="0" max="100" value="{{system.crewMorale}}" />
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.CREW_QUALITY"}}</label>
                <select name="system.crewQuality">
                    {{selectOptions crewQualities selected=system.crewQuality localize=true}}
                </select>
                <span class="crew-skill-chips">
                    <span class="chip origin-mod">{{localize "STARSHIP.CREW_SKILL"}} {{crewSkill}}</span>
                    <span class="chip origin-mod">{{#if (gt crewSpDelta 0)}}+{{/if}}{{crewSpDelta}} SP</span>
                </span>
            </div>
            </div>
        </div>
        <div class="stat-group resources">
            <h3 class="inv-group-label">{{localize "STARSHIP.GROUP_RESOURCES"}}</h3>
            <div class="stat-grid">
            <div class="stat">
                <label>{{localize "STARSHIP.SPACE"}}</label>
                {{#> "rt/capacity-bar" label=(localize "STARSHIP.SPACE") used=derived.spaceUsed total=system.space.total pct=meters.space.pct over=meters.space.over}}
                <input name="system.space.total" type="number" min="0" value="{{system.space.total}}"
                    data-tooltip="{{localize "STARSHIP.DERIVED_HINT"}}" />
                {{/"rt/capacity-bar"}}
            </div>
            <div class="stat">
                <label>{{localize "DYNASTY.SHIP_POINTS"}}</label>
                {{#> "rt/capacity-bar" label=(localize "DYNASTY.SHIP_POINTS") used=derived.spSpent total=system.sp.total pct=meters.sp.pct over=meters.sp.over}}
                <input name="system.sp.total" type="number" min="0" value="{{system.sp.total}}"
                    data-tooltip="{{localize "STARSHIP.DERIVED_HINT"}}" />
                {{/"rt/capacity-bar"}}
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.POWER"}}</label>
                {{> "rt/capacity-bar" label=(localize "STARSHIP.POWER") used=derived.powerUsed total=derived.powerGenerated pct=meters.power.pct over=meters.power.over}}
            </div>
            <div class="stat">
                <label>{{localize "STARSHIP.WEAPON_CAPACITY"}}</label>
                <input name="system.weaponCapacity" type="text" value="{{system.weaponCapacity}}" />
            </div>
            </div>
        </div>
        </div>

        {{!-- Complications (Tables 8-1 / 8-2): sections of their own — the
             stored value with its compendium effect underneath. The effect
             renders ONLY when the ships pack provides it (never fabricated
             if the pack is missing); the roll button returns until a value
             is recorded. --}}
        <div class="complication">
            <h3 class="inv-group-label">{{localize "STARSHIP.ODDITY"}}</h3>
            {{#if oddity.hasValue}}
            <p class="complication-name">{{oddity.name}}</p>
            {{#if oddity.effect}}
            <p class="complication-effect">{{oddity.effect}}</p>
            {{/if}}
            {{else}}
            <button type="button" class="ladder-option" data-action="rollOddity"
                data-tooltip="{{localize "STARSHIP.ROLL_HINT"}}">{{localize "STARSHIP.ROLL"}}</button>
            {{/if}}
        </div>
        <div class="complication">
            <h3 class="inv-group-label">{{localize "STARSHIP.HISTORY"}}</h3>
            {{#if history.hasValue}}
            <p class="complication-name">{{history.name}}</p>
            {{#if history.effect}}
            <p class="complication-effect">{{history.effect}}</p>
            {{/if}}
            {{else}}
            <button type="button" class="ladder-option" data-action="rollHistory"
                data-tooltip="{{localize "STARSHIP.ROLL_HISTORY"}}">{{localize "STARSHIP.ROLL_HISTORY"}}</button>
            {{/if}}
        </div>
    </div>
</section>