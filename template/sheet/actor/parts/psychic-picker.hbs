<div class="psychic-picker">
    {{#if hasPack}}
    <div class="catalog">
        <h2>{{localize "PSYCHIC_POWER.PICKER_TITLE"}}</h2>
        {{#each powers as |power|}}
        <div class="catalog-row {{#if power.owned}}owned{{/if}}">
            <span class="name">{{power.name}} <em>({{localize power.subtypeLabel}})</em></span>
            {{#if power.owned}}
            <span class="owned-marker">{{localize "SKILL.OWNED"}}</span>
            {{else}}
            <a class="add-row" data-action="addPower" data-uuid="{{power.uuid}}"
                data-tooltip="{{localize "SKILL.ADD"}}"><i class="fas fa-plus"></i></a>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="untrained-hint">{{localize "PSYCHIC_POWER.NO_PACK"}}</p>
    {{/if}}
</div>