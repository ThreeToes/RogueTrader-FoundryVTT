<div class="rogue-trader chat damage">
    <div class="background border">
        <h1>
{{!-- Bead qg4z: the weapon name (last title segment) links to its pack doc;
     the attacker → target part stays plain text. Card buttons are untouched. --}}
{{#if titleDoc}}
            {{titleDoc.prefix}}{{#if titleDoc.link}}<a class="adv-doc-link" data-action="{{titleDoc.link.action}}" data-uuid="{{titleDoc.link.uuid}}">{{titleDoc.link.name}}</a>{{else}}{{titleDoc.name}}{{/if}}{{titleDoc.suffix}}
{{else}}
            {{title}}
{{/if}}
        </h1>
        {{#if hitSuccess}}
        <div class="damage-body">
            <p class="damage-location">
                <strong>{{localize "WEAPON.DAMAGE_FULL"}}</strong>
                <span class="location-label">{{localize locationLabelKey}}</span>
                <span class="damage-type">({{localize damageTypeLabelKey}})</span>
                {{#if damageTypeAlternatives}}<span class="damage-type-alternatives"
                    data-tooltip="{{localize "CHAT.DAMAGE_TYPE_ALTERNATIVES_HINT"}}">{{damageTypeAlternatives}}</span>{{/if}}
            </p>
            <p><strong>{{localize "CHAT.DAMAGE"}}:</strong>
                <span class="damage-total">{{damage.rawRoll}}</span>
                {{#if damage.primitiveDouble}}({{localize "CHAT.PRIMITIVE_DOUBLE"}}){{/if}}
                &rarr; <strong class="damage-wounds">{{damage.wounds}}</strong>
                {{localize "WOUNDS.REDUCED"}}
            </p>
            <p><strong>{{localize "WEAPON.PENETRATION_FULL"}}:</strong> {{damage.penApplied}}
                &middot; <strong>{{localize "WOUNDS.ARMOUR"}}</strong> {{damage.effectiveArmour}}
                &middot; <strong>{{localize "WOUNDS.SOAK"}}</strong> {{damage.absorbed}}</p>
            {{#if damageContributors.length}}
            <ul class="modifier-breakdown">
                {{localize "ROLL.MODIFIERS"}}:
                {{#each damageContributors as |mod|}}
                <li>{{mod.label}}: {{mod.value}}{{#if mod.condition}} ({{mod.condition}}){{/if}}</li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if qualityNotes.length}}
            <ul class="quality-notes">
                {{#each qualityNotes as |note|}}
                <li>{{note}}</li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if damage.righteousFury}}
            <p class="righteous-fury"><strong>{{localize "CHAT.RIGHTEOUS_FURY"}}!</strong></p>
            {{/if}}
            {{#if fired}}
            {{!-- Usage chip (bead 4obp, owner decision: manual tracking): the
                 fired item's name + remaining quantity, and the player's own
                 one-click spend. No auto-consumption (deferred bead mrl4). --}}
            <p class="ordnance-usage">
                <strong>{{localize "CHAT.ORDNANCE_FIRED"}}</strong>
                <span class="fired-name">{{fired.name}}</span>
                <span class="fired-quantity">&times;{{fired.quantity}}</span>
                <button class="rt-ammo-decrement" data-uuid="{{fired.uuid}}"
                    data-tooltip="{{localize "CHAT.AMMO_SPEND_HINT"}}">{{localize "CHAT.AMMO_SPEND"}}</button>
            </p>
            {{/if}}
            {{#if toxic}}
            <div class="toxic-prompt">
                <p class="toxic-note">{{toxic.prompt}}</p>
                <div class="centerBtn">
                    <button class="rt-toxic-test" data-target="{{toxic.targetUuid}}" data-wounds="{{toxic.wounds}}" data-penalty="{{toxic.penalty}}" data-tooltip="{{localize "CHAT.TOXIC_TEST_HINT"}}">{{localize "CHAT.TOXIC_TEST"}}</button>
                </div>
            </div>
            {{/if}}
        </div>
        <div class="centerBtn">
            <button class="apply-damage" data-target="{{targetUuid}}" data-wounds="{{damage.wounds}}">{{localize "CHAT.CONTEXT.APPLY_DAMAGE"}}</button>
        </div>
        {{else}}
        <p class="damage-miss">{{#if evaded}}{{localize "DAMAGE.EVADED"}}{{else}}{{localize "DAMAGE.MISS"}}{{/if}}</p>
        {{/if}}
        <p class="damage-note">{{localize "DAMAGE.APPLY_HINT"}}</p>
    </div>
</div>