<section class="tab {{tabs.data.cssClass}}" data-group="primary" data-tab="data">
    <div class="stats border">
        <h1>{{localize "TITLE.CHARACTERISTICS"}}</h1>
        <div class="characteristics-grid">
            {{#each characteristics as |c|}}
            <div class="characteristic stat">
                <div class="char-inputs">
                    <a class="char-roll" data-action="rollTest" data-key="{{c.key}}"
                        data-tooltip="{{localize "ROLL.MODIFIER"}}" title="{{c.label}}"
                    ><i class="fa-solid fa-dice-d10"></i></a>
                    <label class="char-label" for="char-{{c.key}}">{{localize c.label}}</label>
                    <input id="char-{{c.key}}" class="char-value" name="system.characteristics.{{c.key}}.value"
                        type="number" min="0" max="100" value="{{c.value}}" data-tooltip="{{c.label}}" />
                    <input class="char-bonus" title="{{c.bonusTooltip}}" disabled type="text"
                        value="+{{c.bonus}}" />
                    <span class="unnatural-pips {{#if (gt c.unnatural 1)}}has-mult{{/if}}">
                        {{#each c.pips as |pip|}}
                        <button type="button" class="pip {{#if pip.lit}}lit{{/if}}"
                            data-action="setUnnatural" data-key="{{c.key}}"
                            data-value="{{pip.value}}" data-tooltip="{{c.unnaturalTooltip}}"
                        ></button>
                        {{/each}}
                    </span>
                </div>
            </div>
            {{/each}}
        </div>

        <div class="stat-footer derived-row">
            <div class="stat-chip">
                <span class="chip-label">{{localize "DERIVED.MOVEMENT"}}</span>
                <div class="chip-value">
                    <span class="derived-value"
                        data-tooltip="{{localize "DERIVED.HINT_MOVEMENT"}}"
                    >{{derived.half}}/{{derived.full}}/{{derived.charge}}/{{derived.run}}</span>
                </div>
            </div>
            <div class="stat-chip">
                <span class="chip-label">{{localize "DERIVED.INITIATIVE"}}</span>
                <div class="chip-value">
                    <span class="derived-value">+{{derived.initiative}}</span>
                </div>
            </div>
            <div class="stat-chip">
                <span class="chip-label">{{localize "DERIVED.WOUNDS_MAX"}}</span>
                <div class="chip-value">
                    <span class="derived-value"
                        data-tooltip="{{localize "DERIVED.HINT_WOUNDS"}}"
                    >{{derived.woundsMax}}</span>
                </div>
            </div>
            <div class="stat-chip">
                <span class="chip-label">{{localize "DERIVED.FATIGUE_MAX"}}</span>
                <div class="chip-value">
                    <span class="derived-value"
                        data-tooltip="{{localize "DERIVED.HINT_FATIGUE"}}"
                    >{{derived.fatigueMax}}</span>
                </div>
            </div>
        </div>
    </div>
</section>